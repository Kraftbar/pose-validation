diff -ruN a/okvis_kinematics/include/okvis/kinematics/OkvisPortKinDump.hpp b/okvis_kinematics/include/okvis/kinematics/OkvisPortKinDump.hpp
--- a/okvis_kinematics/include/okvis/kinematics/OkvisPortKinDump.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/okvis_kinematics/include/okvis/kinematics/OkvisPortKinDump.hpp	2026-10-02 17:19:42.243388699 +0200
@@ -0,0 +1,125 @@
+/*
+ * okvis_port reference instrumentation (NOT upstream code): binary dumps of Transformation / kinematics helper /
+ * camera model calls for the pure-C port's bit-exactness checks (module M2). Active only when
+ * OKVIS_PORT_KIN_DUMP_DIR is set; with the variable unset (or a kind sampled with every=0) there is no effect.
+ * OKVIS_PORT_KIN_EVERY="mulT=1000,projh=50,..." selects every-N sampling per record kind (0 = count only).
+ * Everything is native-endian raw doubles / u32 / u64. One file per kind: kin_<name>.bin. Layouts are documented in
+ * okvis_port/c/ok_kin.h (kinematics) and okvis_port/c/ok_cam.h (cameras). The destructor prints the call counts
+ * (calls / written) of every kind to stderr, so the reference log shows which functions the pipeline really uses.
+ * No dump code reads uninitialised memory.
+ */
+#ifndef OKVIS_PORT_KIN_DUMP_HPP_
+#define OKVIS_PORT_KIN_DUMP_HPP_
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <Eigen/Core>
+
+namespace okvis_portk {
+
+#define OKP_KINDS(X) \
+  X(T_CTOR_RQ, "ctor_rq") X(T_CTOR_M4, "ctor_m4") X(T_SET_M4, "set_m4") X(T_SET_RQ, "set_rq") \
+  X(T_SETCOEFFS, "setcoeffs") X(T_INV, "inv") X(T_MUL_T, "mul_t") X(T_MUL_V3, "mul_v3") X(T_MUL_V4, "mul_v4") \
+  X(T_OPLUS, "oplus") X(T_OPLUSJ, "oplusj") X(T_LIFTJ, "liftj") X(T_T4, "t4") X(T_T3X4, "t3x4") X(T_C, "c") \
+  X(T_CONVERT, "convert") X(K_SINC, "sinc") X(K_DELTAQ, "deltaq") X(K_RJAC, "rjac") \
+  X(C_PROJ, "proj") X(C_PROJJ, "projj") X(C_PROJX, "projx") X(C_PROJH, "projh") X(C_PROJHJ, "projhj") \
+  X(C_PROJHX, "projhx") X(C_BACK, "back") X(C_BACKJ, "backj") X(C_BACKH, "backh") X(C_BACKHJ, "backhj") \
+  X(C_OVERLAP, "overlap")
+
+enum Kind {
+#define X(k, n) k,
+  OKP_KINDS(X)
+#undef X
+  NUM_KINDS
+};
+
+struct Buf {
+  std::vector<char> b;
+  void raw(const void* p, size_t n) { const char* c = static_cast<const char*>(p); b.insert(b.end(), c, c + n); }
+  void u32(uint32_t v) { raw(&v, 4); }
+  void i32(int32_t v) { raw(&v, 4); }
+  void u64(uint64_t v) { raw(&v, 8); }
+  void f64(double v) { raw(&v, 8); }
+  void f64n(const double* p, size_t n) { raw(p, 8 * n); }
+  template <typename D>
+  void mat(const Eigen::MatrixBase<D>& m) {  // column-major
+    for (Eigen::Index c = 0; c < m.cols(); ++c)
+      for (Eigen::Index r = 0; r < m.rows(); ++r) f64(m(r, c));
+  }
+};
+
+class Dump {
+ public:
+  static Dump& get() { static Dump d; return d; }
+  bool enabled() const { return enabled_; }
+  bool on(Kind k) {  // counts every call; true if this call should be recorded
+    if (!enabled_) return false;
+    std::lock_guard<std::mutex> l(m_);
+    const uint64_t c = calls_[k]++;
+    return every_[k] > 0 && (c % every_[k]) == 0;
+  }
+  void write(Kind k, const Buf& b) {
+    std::lock_guard<std::mutex> l(m_);
+    if (!f_[k]) f_[k] = std::fopen((dir_ + "/kin_" + name(k) + ".bin").c_str(), "wb");
+    std::fwrite(b.b.data(), 1, b.b.size(), f_[k]);
+    written_[k]++;
+  }
+  static const char* name(int k) {
+    static const char* names[] = {
+#define X(kk, n) n,
+        OKP_KINDS(X)
+#undef X
+    };
+    return names[k];
+  }
+  ~Dump() {
+    if (!enabled_) return;
+    for (int k = 0; k < NUM_KINDS; ++k) {
+      if (f_[k]) std::fclose(f_[k]);
+      std::fprintf(stderr, "okvis_port kin dump %s: calls=%llu written=%llu\n", name(k),
+                   (unsigned long long)calls_[k], (unsigned long long)written_[k]);
+    }
+  }
+
+ private:
+  Dump() {
+    const char* d = std::getenv("OKVIS_PORT_KIN_DUMP_DIR");
+    enabled_ = d != nullptr;
+    if (d) dir_ = d;
+    for (int k = 0; k < NUM_KINDS; ++k) { every_[k] = 1; calls_[k] = 0; written_[k] = 0; f_[k] = nullptr; }
+    const char* e = std::getenv("OKVIS_PORT_KIN_EVERY");
+    if (e) {
+      // "name=N,name=N"; "all=N" sets the default for every kind first
+      std::string s(e);
+      size_t pos = 0;
+      while (pos < s.size()) {
+        size_t end = s.find(',', pos);
+        if (end == std::string::npos) end = s.size();
+        const std::string tok = s.substr(pos, end - pos);
+        const size_t eq = tok.find('=');
+        if (eq != std::string::npos) {
+          const std::string nm = tok.substr(0, eq);
+          const uint64_t v = std::strtoull(tok.c_str() + eq + 1, nullptr, 10);
+          for (int k = 0; k < NUM_KINDS; ++k)
+            if (nm == "all" || nm == name(k)) every_[k] = v;
+        }
+        pos = end + 1;
+      }
+    }
+  }
+  bool enabled_ = false;
+  std::string dir_;
+  std::mutex m_;
+  uint64_t every_[NUM_KINDS], calls_[NUM_KINDS], written_[NUM_KINDS];
+  FILE* f_[NUM_KINDS];
+};
+
+}  // namespace okvis_portk
+
+#endif  // OKVIS_PORT_KIN_DUMP_HPP_
