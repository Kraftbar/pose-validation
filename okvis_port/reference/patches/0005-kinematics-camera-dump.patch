+// ---- okvis_port instrumentation wrappers (dump, then return the unmodified implementation's result) ----
+template<class DISTORTION_T>
+void PinholeCamera<DISTORTION_T>::portHeader(okvis_portk::Buf & b) const {
+  const std::string t = distortion_.type();
+  b.u32(t == "RadialTangentialDistortion" ? 0u : t == "EquidistantDistortion" ? 1u
+        : t == "RadialTangentialDistortion8" ? 2u : 3u);
+  b.u32(uint32_t(imageWidth_)); b.u32(uint32_t(imageHeight_));
+  b.f64(fu_); b.f64(fv_); b.f64(cu_); b.f64(cv_);
+  Eigen::VectorXd dp;
+  if (distortion_t::NumDistortionIntrinsics > 0) distortion_.getParameters(dp);
+  b.u32(uint32_t(dp.size()));
+  b.mat(dp);
+}
+
+#define OKP_CAM_ON(K) (okvis_portk::Dump::get().on(okvis_portk::K))
+#define OKP_CAM_WRITE(K, B) okvis_portk::Dump::get().write(okvis_portk::K, B)
+
+template<class DISTORTION_T>
+ProjectionStatus PinholeCamera<DISTORTION_T>::project(
+    const Eigen::Vector3d & point, Eigen::Vector2d * imagePoint) const
+{
+  const ProjectionStatus st = projectPortImpl(point, imagePoint);
+  if (OKP_CAM_ON(C_PROJ)) {
+    okvis_portk::Buf b; portHeader(b); b.mat(point);
+    const bool w = st != ProjectionStatus::Invalid;
+    b.i32(int32_t(st)); b.u32(w ? 1u : 0u);
+    if (w) b.mat(*imagePoint);
+    OKP_CAM_WRITE(C_PROJ, b);
+  }
+  return st;
+}
+
+template<class DISTORTION_T>
+ProjectionStatus PinholeCamera<DISTORTION_T>::project(
+    const Eigen::Vector3d & point, Eigen::Vector2d * imagePoint,
+    Eigen::Matrix<double, 2, 3> * pointJacobian,
+    Eigen::Matrix2Xd * intrinsicsJacobian) const
+{
+  const ProjectionStatus st = projectPortImpl(point, imagePoint, pointJacobian, intrinsicsJacobian);
+  if (OKP_CAM_ON(C_PROJJ)) {
+    okvis_portk::Buf b; portHeader(b); b.mat(point);
+    const bool w = !(fabs(point[2]) < 1.0e-12);
+    b.u32(intrinsicsJacobian ? 1u : 0u);
+    b.i32(int32_t(st)); b.u32(w ? 1u : 0u);
+    if (w) {
+      b.mat(*imagePoint); b.mat(*pointJacobian);
+      if (intrinsicsJacobian) { b.u32(uint32_t(intrinsicsJacobian->cols())); b.mat(*intrinsicsJacobian); }
+    }
+    OKP_CAM_WRITE(C_PROJJ, b);
+  }
+  return st;
+}
+
+template<class DISTORTION_T>
+ProjectionStatus PinholeCamera<DISTORTION_T>::projectWithExternalParameters(
+    const Eigen::Vector3d & point, const Eigen::VectorXd & parameters,
+    Eigen::Vector2d * imagePoint, Eigen::Matrix<double, 2, 3> * pointJacobian,
+    Eigen::Matrix2Xd * intrinsicsJacobian) const
+{
+  const ProjectionStatus st = projectWithExternalParametersPortImpl(point, parameters, imagePoint, pointJacobian,
+                                                                    intrinsicsJacobian);
+  if (OKP_CAM_ON(C_PROJX)) {
+    okvis_portk::Buf b; portHeader(b); b.mat(point);
+    b.u32(uint32_t(parameters.size())); b.mat(parameters);
+    const bool w = !(fabs(point[2]) < 1.0e-12);
+    b.u32(pointJacobian ? 1u : 0u); b.u32(intrinsicsJacobian ? 1u : 0u);
+    b.i32(int32_t(st)); b.u32(w ? 1u : 0u);
+    if (w) {
+      b.mat(*imagePoint);
+      if (pointJacobian) b.mat(*pointJacobian);
+      if (intrinsicsJacobian) { b.u32(uint32_t(intrinsicsJacobian->cols())); b.mat(*intrinsicsJacobian); }
+    }
+    OKP_CAM_WRITE(C_PROJX, b);
+  }
+  return st;
+}
+
