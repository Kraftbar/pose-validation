+// ---- okvis_port instrumentation wrappers ----
+void ImuError::portSnapshot(okvis_port::Buf& b) const {
+  portSnapshotImpl(b, true, true);
+}
+
+// withMeas: include the measurement deque (otherwise only its size)
+void ImuError::portSnapshotImpl(okvis_port::Buf& b, bool withMeas, bool zeroUninit) const {
+  if (withMeas) {
+    b.meas(imuMeasurements_);
+  } else {
+    b.u64(imuMeasurements_.size());
+  }
+  b.params(imuParameters_);
+  b.time(t0_);
+  b.time(t1_);
+  b.f64n(Delta_q_.coeffs().data(), 4);
+  b.f64n(C_integral_.data(), 9);
+  b.f64n(C_doubleintegral_.data(), 9);
+  b.f64n(acc_integral_.data(), 3);
+  b.f64n(acc_doubleintegral_.data(), 3);
+  b.f64n(cross_.data(), 9);
+  b.f64n(dalpha_db_g_.data(), 9);
+  b.f64n(dv_db_g_.data(), 9);
+  b.f64n(dp_db_g_.data(), 9);
+  b.f64n(P_delta_.data(), 225);
+  b.f64n(speedAndBiases_ref_.data(), 9);
+  b.u32(redo_ ? 1u : 0u);
+  b.u32(uint32_t(redoCounter_));
+  // information_/squareRootInformation_ are uninitialised until the first redoPreintegration: dump zeros then
+  // (zeroUninit; not for the post-redo snapshot, where redoCounter_ is only incremented after the call returns)
+  const double zeros[225] = {0};
+  b.f64n((zeroUninit && redoCounter_ == 0) ? zeros : information_.data(), 225);
+  b.f64n((zeroUninit && redoCounter_ == 0) ? zeros : squareRootInformation_.data(), 225);
+  b.u32(uint32_t(dPdsigma_.size()));
+  for (const auto& m : dPdsigma_) b.f64n(m.data(), 225);
+}
+
+int ImuError::append(const okvis::kinematics::Transformation& T_WS,
+                     const okvis::SpeedAndBias & speedAndBiases,
+                     const okvis::ImuMeasurementDeque & imuMeasurements,
+                     const okvis::Time& t_1) {
+  auto& D = okvis_port::Dump::get();
+  if (!D.on(okvis_port::APPEND)) {
+    return appendImpl(T_WS, speedAndBiases, imuMeasurements, t_1);
+  }
+  okvis_port::Buf buf;
+  portSnapshot(buf);  // pre state
+  buf.f64n(speedAndBiases.data(), 9);
+  buf.meas(imuMeasurements);
+  buf.time(t_1);
+  const int ret = appendImpl(T_WS, speedAndBiases, imuMeasurements, t_1);
+  buf.u64(uint64_t(int64_t(ret)));
+  portSnapshotImpl(buf, false, false);  // post state (measurement deque: size only)
+  D.write(okvis_port::APPEND, buf);
+  return ret;
+}
+
+int ImuError::propagation(const okvis::ImuMeasurementDeque & imuMeasurements,
+                          const okvis::ImuParameters & imuParams,
+                          okvis::kinematics::Transformation& T_WS,
+                          okvis::SpeedAndBias & speedAndBiases,
+                          const okvis::Time & t_start,
+                          const okvis::Time & t_end, covariance_t* covariance,
+                          jacobian_t* jacobian) {
+  auto& D = okvis_port::Dump::get();
+  if (!D.on(okvis_port::PROP)) {
+    return propagationImpl(imuMeasurements, imuParams, T_WS, speedAndBiases, t_start, t_end,
+                           covariance, jacobian);
+  }
+  const okvis::kinematics::Transformation T0 = T_WS;
+  const okvis::SpeedAndBias sb0 = speedAndBiases;
+  const int ret = propagationImpl(imuMeasurements, imuParams, T_WS, speedAndBiases, t_start, t_end,
+                                  covariance, jacobian);
+  // second call on copies with covariance + jacobian requested (outputs of the first are unaffected)
+  okvis::kinematics::Transformation T1 = T0;
+  okvis::SpeedAndBias sb1 = sb0;
+  covariance_t cov = covariance_t::Zero();
+  jacobian_t jac = jacobian_t::Zero();
+  const int ret1 = propagationImpl(imuMeasurements, imuParams, T1, sb1, t_start, t_end, &cov, &jac);
+  okvis_port::Buf buf;
+  buf.meas(imuMeasurements);
+  buf.params(imuParams);
+  buf.f64n(T0.coeffs().data(), 7);
+  buf.f64n(sb0.data(), 9);
+  buf.time(t_start);
+  buf.time(t_end);
+  buf.u32(covariance ? 1u : 0u);
+  buf.u32(jacobian ? 1u : 0u);
+  buf.u64(uint64_t(int64_t(ret)));
+  buf.f64n(static_cast<const okvis::kinematics::Transformation&>(T_WS).coeffs().data(), 7);
+  buf.f64n(speedAndBiases.data(), 9);
+  buf.u64(uint64_t(int64_t(ret1)));
+  buf.f64n(static_cast<const okvis::kinematics::Transformation&>(T1).coeffs().data(), 7);
+  buf.f64n(sb1.data(), 9);
+  buf.f64n(cov.data(), 225);
+  buf.f64n(jac.data(), 225);
+  D.write(okvis_port::PROP, buf);
+  return ret;
+}
