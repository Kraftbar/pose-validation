+/*
+ * okvis_port reference instrumentation (NOT upstream code): binary dumps of ImuError inputs/outputs
+ * for the pure-C port's bit-exactness checks. Active only when OKVIS_PORT_DUMP_DIR is set.
+ * OKVIS_PORT_DUMP_EVERY="prop=1,preint=1,append=1,eval=200,append=5" selects every-N sampling per record kind
+ * (0 = off). Files: imu_prop.bin imu_preint.bin imu_append.bin imu_eval.bin in the dump dir.
+ * Everything is native-endian raw doubles / u32 / u64; layouts documented in okvis_port/c/ok_imu.h.
+ */
+#ifndef OKVIS_PORT_DUMP_HPP_
+#define OKVIS_PORT_DUMP_HPP_
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <Eigen/Core>
+#include <okvis/Measurements.hpp>
+#include <okvis/Parameters.hpp>
+#include <okvis/Time.hpp>
+
+namespace okvis_port {
+
+enum Kind { PROP = 0, PREINT = 1, APPEND = 2, EVAL = 3, INITPOSE = 4, NUM_KINDS = 5 };
+
+struct Buf {
+  std::vector<char> b;
+  void raw(const void* p, size_t n) { const char* c = static_cast<const char*>(p); b.insert(b.end(), c, c + n); }
+  void u32(uint32_t v) { raw(&v, 4); }
+  void u64(uint64_t v) { raw(&v, 8); }
+  void f64(double v) { raw(&v, 8); }
+  void f64n(const double* p, size_t n) { raw(p, 8 * n); }
+  void time(const okvis::Time& t) { u32(t.sec); u32(t.nsec); }
+  void meas(const okvis::ImuMeasurementDeque& d) {
+    u64(d.size());
+    for (const auto& m : d) {
+      time(m.timeStamp);
+      f64n(m.measurement.gyroscopes.data(), 3);
+      f64n(m.measurement.accelerometers.data(), 3);
+    }
+  }
+  void params(const okvis::ImuParameters& p) {
+    f64(p.sigma_g_c); f64(p.sigma_a_c); f64(p.sigma_gw_c); f64(p.sigma_aw_c);
+    f64(p.g); f64(p.g_max); f64(p.a_max);
+  }
+};
+
+class Dump {
+ public:
+  static Dump& get() { static Dump d; return d; }
+  bool on(Kind k) {  // true if this call should be recorded (counts every call)
+    if (!dir_.size()) return false;
+    std::lock_guard<std::mutex> l(m_);
+    const uint64_t c = calls_[k]++;
+    return every_[k] > 0 && (c % every_[k]) == 0;
+  }
+  void write(Kind k, const Buf& b) {
+    std::lock_guard<std::mutex> l(m_);
+    if (!f_[k]) {
+      static const char* names[] = {"imu_prop.bin", "imu_preint.bin", "imu_append.bin", "imu_eval.bin", "imu_initpose.bin"};
+      f_[k] = std::fopen((dir_ + "/" + names[k]).c_str(), "wb");
+    }
+    std::fwrite(b.b.data(), 1, b.b.size(), f_[k]);
+    written_[k]++;
+  }
+  ~Dump() {
+    for (int k = 0; k < NUM_KINDS; ++k) {
+      if (f_[k]) std::fclose(f_[k]);
+      if (dir_.size()) std::fprintf(stderr, "okvis_port dump kind %d: calls=%llu written=%llu\n", k,
+                                    (unsigned long long)calls_[k], (unsigned long long)written_[k]);
+    }
+  }
+ private:
+  Dump() {
+    const char* d = std::getenv("OKVIS_PORT_DUMP_DIR");
+    if (d) dir_ = d;
+    for (int k = 0; k < NUM_KINDS; ++k) { every_[k] = 1; calls_[k] = 0; written_[k] = 0; f_[k] = nullptr; }
+    every_[EVAL] = 200; every_[APPEND] = 5;
+    const char* e = std::getenv("OKVIS_PORT_DUMP_EVERY");
+    if (e) {
+      std::string s(e);
+      const char* names[] = {"prop", "preint", "append", "eval", "initpose"};
+      for (int k = 0; k < NUM_KINDS; ++k) {
+        size_t p = s.find(std::string(names[k]) + "=");
+        if (p != std::string::npos) every_[k] = std::atoi(s.c_str() + p + std::strlen(names[k]) + 1);
+      }
+    }
+  }
+  std::string dir_;
+  std::mutex m_;
+  uint64_t every_[NUM_KINDS], calls_[NUM_KINDS], written_[NUM_KINDS];
+  FILE* f_[NUM_KINDS];
+};
+
+}  // namespace okvis_port
+
+#endif  // OKVIS_PORT_DUMP_HPP_
