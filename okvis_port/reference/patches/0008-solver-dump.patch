+// okvis_port (patch 0008): Problem snapshot helpers for the solver dump (okvis_port/c/ok_solve.h documents the layout).
+namespace {
+uint32_t portCostType(const ::ceres::CostFunction* cf, bool& oracle) {
+  oracle = false;
+  if (dynamic_cast<const okvis::ceres::ReprojectionError2dBase*>(cf)) return 1;
+  if (dynamic_cast<const okvis::ceres::ImuError*>(cf)) return 2;
+  if (dynamic_cast<const okvis::ceres::PoseError*>(cf)) return 3;
+  if (dynamic_cast<const okvis::ceres::SpeedAndBiasError*>(cf)) return 4;
+  if (dynamic_cast<const okvis::ceres::RelativePoseError*>(cf)) return 5;
+  if (dynamic_cast<const okvis::ceres::HomogeneousPointError*>(cf)) return 6;
+  oracle = true;  // not ported yet: raw Evaluate outputs are recorded (R_ORACLE)
+  if (dynamic_cast<const okvis::ceres::TwoPoseGraphError*>(cf)) return 7;
+  if (dynamic_cast<const okvis::ceres::TwoPoseGraphErrorConst*>(cf)) return 8;
+  if (dynamic_cast<const okvis::ceres::TwoPoseExtrinsicsGraphError*>(cf)) return 9;
+  if (dynamic_cast<const okvis::ceres::TwoPoseExtrinsicsGraphErrorConst*>(cf)) return 10;
+  return 0;
+}
+void portCostPayload(uint32_t type, const ::ceres::CostFunction* cf, okvis_port_solve::Buf& out) {
+  okvis_portk::Buf b;
+  switch (type) {
+    case 1: dynamic_cast<const okvis::ceres::ReprojectionError2dBase*>(cf)->portDump(b); break;
+    case 2: { okvis_port::Buf ib; dynamic_cast<const okvis::ceres::ImuError*>(cf)->portSnapshotImpl(ib, true, true);
+              b.raw(ib.b.data(), ib.b.size()); break; }
+    case 3: dynamic_cast<const okvis::ceres::PoseError*>(cf)->portDump(b); break;
+    case 4: dynamic_cast<const okvis::ceres::SpeedAndBiasError*>(cf)->portDump(b); break;
+    case 5: dynamic_cast<const okvis::ceres::RelativePoseError*>(cf)->portDump(b); break;
+    case 6: dynamic_cast<const okvis::ceres::HomogeneousPointError*>(cf)->portDump(b); break;
+    default: break;
+  }
+  out.u64(uint64_t(b.b.size()));
+  out.raw(b.b.data(), b.b.size());
+}
