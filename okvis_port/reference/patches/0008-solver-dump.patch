@@ -0,0 +1,76 @@
+/* okvis_port reference instrumentation (NOT upstream code, patch 0008): per-Solve() dump of the Ceres problem
+ * snapshot and of the trust-region / Dogleg / linear-solver internals, used by okvis_port/c/check_ok_solve.c.
+ * Active only while okvis::ViGraph::optimise arms it (OKVIS_PORT_SOLVE_DUMP_DIR set). Purely observational:
+ * nothing here changes a computed value. The global state is defined in internal/ceres/solver.cc.
+ *
+ * Stream solve.bin = sequence of framed records: u32 tag, u64 payload length, payload (native endian).
+ * Record layouts are documented in okvis_port/c/ok_solve.h.
+ */
+#ifndef CERES_OKVIS_PORT_SOLVE_HOOKS_H_
+#define CERES_OKVIS_PORT_SOLVE_HOOKS_H_
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <unordered_set>
+#include <vector>
+
+namespace okvis_port_solve {
+
+enum Record : uint32_t {
+  R_SOLVE = 1,    // ViGraph::optimise: options + sampling level
+  R_PROBLEM = 2,  // ViGraph::optimise: Problem snapshot (parameter blocks, residual blocks, cost-function payloads)
+  R_REDUCED = 3,  // solver.cc: reduced program order after preprocessing/reordering
+  R_ITER = 4,     // trust_region_minimizer.cc: one record per iteration (summary + internals)
+  R_DOGLEG = 5,   // dogleg_strategy.cc: ComputeTraditionalDoglegStep
+  R_GN = 6,       // dogleg_strategy.cc: ComputeGaussNewtonStep (mu loop)
+  R_SCHUR = 7,    // schur_complement_solver.cc: detected structure / eliminator kind (once per Solve)
+  R_DENSE = 8,    // schur_complement_solver.cc: reduced dense system (lhs, rhs, solution)
+  R_SPARSE = 9,   // sparse_normal_cholesky_solver.cc: J^T J (CRS), rhs, solution
+  R_ORACLE = 10,  // residual_block.cc: raw cost-function outputs of not-yet-ported terms
+  R_END = 11,     // solver.cc: termination, final cost, parameter hash
+  R_PROGRAM = 12  // solver.cc: the Problem program order of parameter / residual blocks before preprocessing
+};
+
+struct Buf {
+  std::vector<char> b;
+  void raw(const void* p, size_t n) { const char* c = static_cast<const char*>(p); b.insert(b.end(), c, c + n); }
+  void u32(uint32_t v) { raw(&v, 4); }
+  void i32(int32_t v) { raw(&v, 4); }
+  void u64(uint64_t v) { raw(&v, 8); }
+  void f64(double v) { raw(&v, 8); }
+  void f64n(const double* p, size_t n) { raw(p, 8 * n); }
+  void i32n(const int* p, size_t n) { raw(p, 4 * n); }
+};
+
+inline uint64_t fnv(const void* p, size_t n) {
+  const unsigned char* c = static_cast<const unsigned char*>(p);
+  uint64_t h = 1469598103934665603ULL;
+  for (size_t i = 0; i < n; ++i) { h ^= c[i]; h *= 1099511628211ULL; }
+  return h;
+}
+inline uint64_t fnvd(const double* p, size_t n) { return fnv(p, 8 * n); }
+
+struct State {
+  FILE* f = nullptr;
+  bool enabled = false;  // OKVIS_PORT_SOLVE_DUMP_DIR set and file open
+  bool armed = false;    // inside ViGraph::optimise's ::ceres::Solve
+  int level = 0;         // 0: per-iteration summary only; 1: + snapshot and hashes; 2: + full vectors
+  uint64_t solve_id = 0;
+  std::unordered_set<const void*> oracle;  // cost functions whose raw Evaluate outputs are recorded
+  bool reuse = false;    // DoglegStrategy: ComputeStep took the reuse branch
+  int mu_increases = 0;  // DoglegStrategy: number of mu increases in the last ComputeGaussNewtonStep
+  bool on(int min_level) const { return enabled && armed && level >= min_level; }
+  void write(uint32_t rec, const Buf& b) {
+    if (!f) return;
+    const uint64_t n = b.b.size();
+    std::fwrite(&rec, 4, 1, f);
+    std::fwrite(&n, 8, 1, f);
+    if (n) std::fwrite(b.b.data(), 1, n, f);
+  }
+};
+extern State g;
+
+}  // namespace okvis_port_solve
+
+#endif  // CERES_OKVIS_PORT_SOLVE_HOOKS_H_
