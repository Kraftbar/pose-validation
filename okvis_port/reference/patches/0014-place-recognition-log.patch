+  /// okvis_port (patch 0014): raw dump of the loaded tree (k, L, weighting, scoring, then per node: id, parent, word id, weight,
+  /// children, descriptor bytes) as the Frontend instrumentation writes it; only instantiated for the 48-byte BRISK descriptors.
+  template <class Buf>
+  void portDump(Buf& b) const
+  {
+    b.u32(uint32_t(m_k)); b.u32(uint32_t(m_L)); b.u32(uint32_t(m_weighting)); b.u32(uint32_t(m_scoring));
+    b.u32(uint32_t(m_nodes.size())); b.u32(uint32_t(m_words.size()));
+    for(size_t i = 0; i < m_nodes.size(); ++i)
+    {
+      const Node& n = m_nodes[i];
+      b.u32(uint32_t(n.id)); b.u32(uint32_t(n.parent)); b.u32(uint32_t(n.word_id));
+      const double w = n.weight; b.f64n(&w, 1);
+      b.u32(uint32_t(n.children.size()));
+      for(size_t c = 0; c < n.children.size(); ++c) b.u32(uint32_t(n.children[c]));
+      b.u32(uint32_t(n.descriptor.size()));
+      if(!n.descriptor.empty()) b.raw(&n.descriptor[0], n.descriptor.size());
+    }
+  }
