+// okvis_port (patch 0014): PLACE RECOGNITION log (OKVIS_PORT_PLACE_DIR/place.bin, framing as ransac.bin; layouts in
+// okvis_port/c/ok_dbow.h): 170 vocabulary tree, 171 database add, 172 query + filtered result, 173 verifyRecognisedPlace stages.
+// No numerical effect.
+static FILE* portPlaceFile() {
+  static FILE* f = []() -> FILE* {
+    const char* d = std::getenv("OKVIS_PORT_PLACE_DIR");
+    if (!d) return nullptr;
+    return std::fopen((std::string(d) + "/place.bin").c_str(), "wb");
+  }();
+  return f;
+}
+static void portPlaceWrite(uint32_t tag, const PortRansacBuf& b) {
+  FILE* f = portPlaceFile();
+  if (!f) return;
+  const uint64_t len = b.b.size();
+  std::fwrite(&tag, 4, 1, f);
+  std::fwrite(&len, 8, 1, f);
+  std::fwrite(b.b.data(), 1, b.b.size(), f);
+  std::fflush(f);
+}
+static uint64_t g_portPlaceFrame = 0;  // the multiframe id of the current place-recognition block
+static void portPutBow(PortRansacBuf& b, const DBoW2::BowVector& v) {
+  b.u32(uint32_t(v.size()));
+  for (const auto& it : v) { b.u32(uint32_t(it.first)); const double w = it.second; b.f64n(&w, 1); }
+}
