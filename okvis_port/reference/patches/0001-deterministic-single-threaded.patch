0001: deterministic single-threaded schedule for the OKVIS2 reference build.
 - ThreadedSlam::processFrame: join the realtime optimisation thread, then run the background
   (loop-closure / pose-graph) optimisation to completion inside the same frame, so import timing
   no longer depends on wall-clock races (isLoopClosing_/isLoopClosureAvailable_ were read unlocked
   by the realtime thread while the full-graph thread wrote them).
 - ThreadedSlam: publication queue pushes block instead of dropping (causal trajectory file is complete).
 - Frontend::matchToMap{,Uninitialised}: the num_matching_threads keypoint segments are executed one
   after another on the calling thread (identical partition => identical results; the segmentation is
   semantic because reprErr is averaged per segment).
 - opengv SampleConsensusProblem/MultiSampleConsensusProblem: RANSAC RNG always seeded 12345 (upstream
   default is time(0)+clock()).
diff -ru pristine/external/opengv/include/opengv/sac/implementation/MultiSampleConsensusProblem.hpp work/external/opengv/include/opengv/sac/implementation/MultiSampleConsensusProblem.hpp
--- pristine/external/opengv/include/opengv/sac/implementation/MultiSampleConsensusProblem.hpp	2026-10-01 18:15:27.756774940 +0200
+++ work/external/opengv/include/opengv/sac/implementation/MultiSampleConsensusProblem.hpp	2026-10-01 20:24:59.467243772 +0200
@@ -39,7 +39,7 @@
 {
   rng_dist_.reset(new std::uniform_int_distribution<>( 0, std::numeric_limits<int>::max () ));
   // Create a random number generator object
-  if (randomSeed)
+  if (false && randomSeed) // DETERMINISTIC REFERENCE: always the fixed seed
     rng_alg_.seed(static_cast<unsigned>(time(0)) + static_cast<unsigned>(clock()) );
   else
     rng_alg_.seed(12345u);
