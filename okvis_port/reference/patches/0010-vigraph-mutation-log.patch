+/*
+ * okvis_port reference instrumentation (NOT upstream code, patch 0010): ViGraph-level mutation log for module M5d.
+ * Active only with OKVIS_PORT_GRAPH_DUMP_DIR. Records go into the same framed stream as the Ceres Problem log
+ * (problem.bin, tags >= 32; layouts in okvis_port/c/ok_vigraph.h), so one pass replays "graph mutation -> the Problem
+ * calls it caused": the Problem events of a mutation precede its record, which is written when the OUTERMOST
+ * mutation returns (nested ViGraph calls, e.g. removeObservation inside convertToPoseGraphMst, are not logged).
+ * Observational only: no computed value changes, no uninitialised memory is read.
+ */
+#ifndef OKVIS_PORT_VIGRAPH_LOG_HPP_
+#define OKVIS_PORT_VIGRAPH_LOG_HPP_
+
+#include <cstdint>
+#include <map>
+#include <set>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <ceres/okvis_port_solve_hooks.h>
+#include <okvis/kinematics/OkvisPortKinDump.hpp>
+#include <okvis/FrameTypedefs.hpp>
+#include <okvis/Measurements.hpp>
+#include <okvis/Parameters.hpp>
+#include <okvis/Time.hpp>
+#include <okvis/kinematics/Transformation.hpp>
+
+namespace okvis_portv {
+
+using Buf = okvis_portk::Buf;
+
+enum Op : uint32_t {
+  M_NEW = 32, M_ADDCAM, M_ADDIMU, M_INIT, M_PROP, M_ADDLM_ID, M_ADDLM_NEW, M_RMLM, M_SETLM_INIT, M_SETLMQ,
+  M_SETLM_FULL, M_SETLM, M_SETCLASS, M_ADDOBS, M_ADDEXTOBS, M_RMOBS, M_COVIS, M_ADDRELPOSE, M_RMRELPOSE, M_SETKF,
+  M_SETPOSE, M_SETSB, M_SETEXTR, M_UPDLM, M_OPT, M_CLEANLM, M_RMALLOBS, M_ELIM, M_MERGELM, M_FREEZE_POSES,
+  M_UNFREEZE_POSES, M_FREEZE_SB, M_UNFREEZE_SB, M_MST, M_ADDEXTTP, M_RMTPC_ALL, M_RMTPC, M_CONVOBS, M_RMSBPRIOR,
+  M_CLEAR, M_EXTVAR, M_SOFTEXT,
+  // direct accesses of ViSlamBackend to a graph's members
+  M_POKE_FIX_ADD = 96, M_POKE_FIX_REMOVE, M_POKE_LM_CONST, M_POKE_SETINFO, M_POKE_COPYSTATE, M_POKE_SYNCIMU
+};
+
+inline int& depth() { static thread_local int d = 0; return d; }
+inline bool on() { return okvis_port_solve::plog.on(); }
+
+inline void putTime(Buf& b, const okvis::Time& t) { b.u32(t.sec); b.u32(t.nsec); }
+inline void putMeas(Buf& b, const okvis::ImuMeasurementDeque& d) {
+  b.u64(d.size());
+  for (const auto& m : d) {
+    putTime(b, m.timeStamp);
+    b.f64n(m.measurement.gyroscopes.data(), 3);
+    b.f64n(m.measurement.accelerometers.data(), 3);
+  }
+}
+inline void putT(Buf& b, const okvis::kinematics::Transformation& T) { const auto& c = T.coeffs(); b.f64n(c.data(), 7); }
+inline void putTC(Buf& b, const okvis::kinematics::TransformationCacheless& T) { const auto& c = T.coeffs(); b.f64n(c.data(), 7); }
+inline void putKid(Buf& b, const okvis::KeypointIdentifier& k) { b.u64(k.frameId); b.u32(uint32_t(k.cameraIndex)); b.u32(uint32_t(k.keypointIndex)); }
+
+/// RAII record of one OUTERMOST graph mutation: `a` = arguments, `r` = results; written when it goes out of scope.
+class Scope {
+ public:
+  Scope(uint32_t op, const void* graph) : op_(op), graph_(graph) {
+    on_ = on();
+    if (on_) top_ = (depth()++ == 0);
+  }
+  ~Scope() {
+    if (!on_) return;
+    --depth();
+    if (!top_) return;
+    okvis_port_solve::Buf b;
+    b.u64(uint64_t(reinterpret_cast<uintptr_t>(graph_)));
+    b.u32(uint32_t(a.b.size()));
+    b.raw(a.b.data(), a.b.size());
+    b.raw(r.b.data(), r.b.size());
+    okvis_port_solve::plog.write(op_, b);
+  }
+  bool top() const { return on_ && top_; }
+  Buf a, r;
+ private:
+  uint32_t op_;
+  const void* graph_;
+  bool on_ = false, top_ = false;
+};
