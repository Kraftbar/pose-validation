diff -ruN a/okvis_ceres/include/okvis/ceres/OkvisPortErrDump.hpp b/okvis_ceres/include/okvis/ceres/OkvisPortErrDump.hpp
--- a/okvis_ceres/include/okvis/ceres/OkvisPortErrDump.hpp
+++ b/okvis_ceres/include/okvis/ceres/OkvisPortErrDump.hpp	2026-10-03 00:25:51.991162030 +0200
@@ -0,0 +1,163 @@
+/*
+ * okvis_port reference instrumentation (NOT upstream code): binary dumps of the error terms (ReprojectionError,
+ * PoseError, SpeedAndBiasError, RelativePoseError, HomogeneousPointError), their information/LLT set-up and the
+ * pose / homogeneous-point manifolds for the pure-C port's bit-exactness checks (module M3). Active only when
+ * OKVIS_PORT_ERR_DUMP_DIR is set; OKVIS_PORT_ERR_EVERY="reproj=1000,pplus=1,..." selects every-N sampling per
+ * record kind (0 = count only, "all=N" sets the default first). One file per kind: err_<name>.bin, native-endian raw
+ * doubles / u32. Layouts are documented in okvis_port/c/ok_err.h and ok_param.h. The destructor prints the call
+ * counts (calls / written) of every kind to stderr. No dump code reads uninitialised memory.
+ */
+#ifndef OKVIS_PORT_ERR_DUMP_HPP_
+#define OKVIS_PORT_ERR_DUMP_HPP_
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <Eigen/Core>
+#include <okvis/kinematics/OkvisPortKinDump.hpp>
+
+namespace okvis_porte {
+
+#define OKP_E_KINDS(X) \
+  X(E_REPROJ, "reproj") X(E_POSE, "pose") X(E_SAB, "sab") X(E_RELPOSE, "relpose") X(E_HPOINT, "hpoint") \
+  X(E_LLT, "llt") X(E_CTOR, "ctor") \
+  X(M_PPLUS, "pplus") X(M_PPLUSJ, "pplusj") X(M_PMINUS, "pminus") X(M_PMINUSJ, "pminusj") \
+  X(M_HPLUS, "hplus") X(M_HPLUSJ, "hplusj") X(M_HMINUS, "hminus") X(M_HMINUSJ, "hminusj")
+
+enum Kind {
+#define X(k, n) k,
+  OKP_E_KINDS(X)
+#undef X
+  NUM_KINDS
+};
+
+using Buf = okvis_portk::Buf;
+
+class Dump {
+ public:
+  static Dump& get() { static Dump d; return d; }
+  bool on(Kind k) {  // counts every call; true if this call should be recorded
+    if (!enabled_) return false;
+    std::lock_guard<std::mutex> l(m_);
+    const uint64_t c = calls_[k]++;
+    return every_[k] > 0 && (c % every_[k]) == 0;
+  }
+  void write(Kind k, const Buf& b) {
+    std::lock_guard<std::mutex> l(m_);
+    if (!f_[k]) f_[k] = std::fopen((dir_ + "/err_" + name(k) + ".bin").c_str(), "wb");
+    std::fwrite(b.b.data(), 1, b.b.size(), f_[k]);
+    written_[k]++;
+  }
+  static const char* name(int k) {
+    static const char* names[] = {
+#define X(kk, n) n,
+        OKP_E_KINDS(X)
+#undef X
+    };
+    return names[k];
+  }
+  ~Dump() {
+    if (!enabled_) return;
+    for (int k = 0; k < NUM_KINDS; ++k) {
+      if (f_[k]) std::fclose(f_[k]);
+      std::fprintf(stderr, "okvis_port err dump %s: calls=%llu written=%llu\n", name(k),
+                   (unsigned long long)calls_[k], (unsigned long long)written_[k]);
+    }
+  }
+
+ private:
+  Dump() {
+    const char* d = std::getenv("OKVIS_PORT_ERR_DUMP_DIR");
+    enabled_ = d != nullptr;
+    if (d) dir_ = d;
+    for (int k = 0; k < NUM_KINDS; ++k) { every_[k] = 1; calls_[k] = 0; written_[k] = 0; f_[k] = nullptr; }
+    const char* e = std::getenv("OKVIS_PORT_ERR_EVERY");
+    if (e) {
+      std::string s(e);
+      size_t pos = 0;
+      while (pos < s.size()) {
+        size_t end = s.find(',', pos);
+        if (end == std::string::npos) end = s.size();
+        const std::string tok = s.substr(pos, end - pos);
+        const size_t eq = tok.find('=');
+        if (eq != std::string::npos) {
+          const std::string nm = tok.substr(0, eq);
+          const uint64_t v = std::strtoull(tok.c_str() + eq + 1, nullptr, 10);
+          for (int k = 0; k < NUM_KINDS; ++k)
+            if (nm == "all" || nm == name(k)) every_[k] = v;
+        }
+        pos = end + 1;
+      }
+    }
+  }
+  bool enabled_ = false;
+  std::string dir_;
+  std::mutex m_;
+  uint64_t every_[NUM_KINDS], calls_[NUM_KINDS], written_[NUM_KINDS];
+  FILE* f_[NUM_KINDS];
+};
+
+// Evaluate record tail shared by all error terms: [u32 nblocks] per block: u32 size, f64 params[size];
+// u32 have_J (jacobians != nullptr); per block: u32 J nonnull, u32 have_Jmin, u32 Jmin nonnull;
+// then u32 return, f64 residuals[nres], per block with nonnull J: f64 J[nres*size] (row-major as written),
+// per block where the minimal Jacobian is written (Jmin nonnull and, except for SpeedAndBiasError, J nonnull):
+// f64 Jmin[nres*minsize] (row-major).
+inline void evalIn(Buf& b, int nb, const int* sz, double const* const* parameters,
+                   double* const* jacobians, double* const* jacobiansMinimal) {
+  b.u32(uint32_t(nb));
+  for (int k = 0; k < nb; ++k) { b.u32(uint32_t(sz[k])); b.f64n(parameters[k], size_t(sz[k])); }
+  b.u32(jacobians ? 1u : 0u);
+  for (int k = 0; k < nb; ++k) {
+    b.u32(jacobians && jacobians[k] ? 1u : 0u);
+    b.u32(jacobiansMinimal ? 1u : 0u);
+    b.u32(jacobiansMinimal && jacobiansMinimal[k] ? 1u : 0u);
+  }
+}
+// minIndependent: the minimal Jacobian is written even when jacobians == nullptr (SpeedAndBiasError); otherwise
+// both Jacobians are only written inside the `jacobians[k] != nullptr` branch (all other error terms).
+inline void evalOut(Buf& b, int nb, int nres, const int* sz, const int* msz, bool ret, const double* residuals,
+                    double* const* jacobians, double* const* jacobiansMinimal, bool minIndependent) {
+  b.u32(ret ? 1u : 0u);
+  b.f64n(residuals, size_t(nres));
+  for (int k = 0; k < nb; ++k)
+    if (jacobians && jacobians[k]) b.f64n(jacobians[k], size_t(nres * sz[k]));
+  for (int k = 0; k < nb; ++k) {
+    const bool w = jacobiansMinimal && jacobiansMinimal[k] && (minIndependent || (jacobians && jacobians[k]));
+    if (w) b.f64n(jacobiansMinimal[k], size_t(nres * msz[k]));
+  }
+}
+
+// Row-major dump of an Eigen matrix expression (information matrices etc.)
+template <typename D>
+inline void rowmajor(Buf& b, const Eigen::MatrixBase<D>& m) {
+  for (Eigen::Index r = 0; r < m.rows(); ++r)
+    for (Eigen::Index c = 0; c < m.cols(); ++c) b.f64(m(r, c));
+}
+
+// LLT set-up record (setInformation of every error term): u32 n, f64 information[n*n] (row-major),
+// f64 squareRootInformation[n*n] (row-major).
+template <typename D1, typename D2>
+inline void lltRecord(const Eigen::MatrixBase<D1>& info, const Eigen::MatrixBase<D2>& sq) {
+  if (!Dump::get().on(E_LLT)) return;
+  Buf b; b.u32(uint32_t(info.rows())); rowmajor(b, info); rowmajor(b, sq);
+  Dump::get().write(E_LLT, b);
+}
+// Constructor record: u32 tag (0 PoseError(T,diag) 1 PoseError(T,tv,rv) 2 SpeedAndBiasError(sb,sv,gv,av)
+// 3 RelativePoseError(tv,rv,T) 4 HomogeneousPointError(m,variance)), u32 nin, f64 in[nin], u32 n,
+// f64 information_[n*n], f64 squareRootInformation_[n*n] (row-major).
+template <typename D1, typename D2>
+inline void ctorRecord(uint32_t tag, const double* in, uint32_t nin, const Eigen::MatrixBase<D1>& info,
+                       const Eigen::MatrixBase<D2>& sq) {
+  if (!Dump::get().on(E_CTOR)) return;
+  Buf b; b.u32(tag); b.u32(nin); b.f64n(in, nin); b.u32(uint32_t(info.rows())); rowmajor(b, info); rowmajor(b, sq);
+  Dump::get().write(E_CTOR, b);
+}
+
+}  // namespace okvis_porte
+
+#endif  // OKVIS_PORT_ERR_DUMP_HPP_
