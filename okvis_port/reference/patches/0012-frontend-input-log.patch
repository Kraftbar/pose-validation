 /// \brief okvis Main namespace of this package.
 namespace okvis {
 
+// okvis_port (patch 0012): log of every OpenGV RANSAC run of the frontend (layout in OkvisPortVigraphLog.hpp)
+template <class R>
+static void portLogRansac(uint32_t kind, size_t numCorr, const R& r) {
+  if (!okvis_portv::on()) return;
+  okvis_portv::Buf b;
+  b.u32(kind); b.u32(uint32_t(numCorr)); b.u32(uint32_t(r.iterations_)); b.u32(uint32_t(r.inliers_.size()));
+  for (int i : r.inliers_) b.u32(uint32_t(i));
+  b.u32(uint32_t(r.model_coefficients_.rows())); b.u32(uint32_t(r.model_coefficients_.cols()));
+  b.f64n(r.model_coefficients_.data(), size_t(r.model_coefficients_.size()));
+  okvis_portv::bWrite(okvis_portv::B_RANSAC, b);
+}
