+
 namespace basalt {
 
+// ---- basalt_port instrumentation helpers (observation only) ----
+namespace {
+// IMU_PREINT record (tag 2) in imu.bin:
+//   i64 start_t_ns, i64 end_t_ns, S bg_lin[3], S ba_lin[3], S accel_cov[3], S gyro_cov[3],
+//   u32 ns, ns x { i64 t_ns, S accel[3], S gyro[3] } (calibrated, as handed to integrate(); the tail sample carries the frame time),
+//   i64 dt_ns, S dq[4](x,y,z,w), S dp[3], S dv[3], S cov[81], S d_state_d_ba[27], S d_state_d_bg[27] (col major)
+template <class Scalar>
+void port_emit_preint(const IntegratedImuMeasurement<Scalar>& meas, int64_t start_t, int64_t end_t,
+                      const Eigen::Matrix<Scalar, 3, 1>& bg, const Eigen::Matrix<Scalar, 3, 1>& ba,
+                      const Eigen::Matrix<Scalar, 3, 1>& acov, const Eigen::Matrix<Scalar, 3, 1>& gcov,
+                      const std::vector<ImuData<Scalar>>& samples) {
+  port::Buf b;
+  b.i64(start_t);
+  b.i64(end_t);
+  b.arr(bg.data(), 3);
+  b.arr(ba.data(), 3);
+  b.arr(acov.data(), 3);
+  b.arr(gcov.data(), 3);
+  b.u32((uint32_t)samples.size());
+  for (const auto& d : samples) {
+    b.i64(d.t_ns);
+    b.arr(d.accel.data(), 3);
+    b.arr(d.gyro.data(), 3);
+  }
+  const auto& ds = meas.getDeltaState();
+  b.i64(meas.get_dt_ns());
+  b.arr(ds.T_w_i.unit_quaternion().coeffs().data(), 4);
+  b.arr(ds.T_w_i.translation().data(), 3);
+  b.arr(ds.vel_w_i.data(), 3);
+  b.arr(meas.get_cov().data(), 81);
+  b.arr(meas.get_d_state_d_ba().data(), 27);
+  b.arr(meas.get_d_state_d_bg().data(), 27);
+  // NOTE: sqrt_cov_inv is deliberately NOT dumped. Calling get_sqrt_cov_inv() from this translation unit would instantiate
+  // IntegratedImuMeasurement<float>::compute_sqrt_cov_inv here, where the unqualified sqrt(float) of preintegration.h resolves to
+  // ::sqrt(double); the linker would then pick this copy over the (float sqrtss) copy of the linearization units and change the
+  // trajectory (ODR hazard, see basalt_port/PLAN.md).
+  port::D().write(port::S_IMU, port::T_IMU_PREINT, b.b);
+}
+
+// landmark ids in lmdb iteration order (the order that fixes the landmark block / QR row / float accumulation order)
+template <class Lmdb>
+uint64_t port_lm_order_hash(const Lmdb& lmdb, std::vector<uint64_t>* ids = nullptr) {
+  uint64_t h = port::fnv(nullptr, 0);
+  for (const auto& kv : lmdb.getLandmarks()) {
+    uint64_t id = kv.first;
+    h = port::fnvT(id, h);
+    if (ids) ids->push_back(id);
+  }
+  return h;
+}
+// host frames in lmdb.getObservations() iteration order (the order computeError sums in)
+template <class Lmdb>
+uint64_t port_host_order_hash(const Lmdb& lmdb, std::vector<std::pair<int64_t, uint64_t>>* hosts = nullptr) {
+  uint64_t h = port::fnv(nullptr, 0);
+  for (const auto& kv : lmdb.getObservations()) {
+    int64_t f = kv.first.frame_id;
+    uint64_t c = kv.first.cam_id;
+    h = port::fnvT(f, h);
+    h = port::fnvT(c, h);
+    if (hosts) hosts->emplace_back(f, c);
+  }
+  return h;
+}
+// landmark values hashed in ascending id order (independent of container order)
+template <class Lmdb>
+uint64_t port_lm_value_hash(const Lmdb& lmdb) {
+  std::vector<uint64_t> ids;
+  for (const auto& kv : lmdb.getLandmarks()) ids.push_back(kv.first);
+  std::sort(ids.begin(), ids.end());
+  uint64_t h = port::fnv(nullptr, 0);
+  for (uint64_t id : ids) {
+    const auto& k = lmdb.getLandmark(id);
+    int64_t hf = k.host_kf_id.frame_id;
