diff -ruN a/include/basalt/utils/bs_port_dump.h b/include/basalt/utils/bs_port_dump.h
--- a/include/basalt/utils/bs_port_dump.h	1970-01-01 01:00:00.000000000 +0100
+++ b/include/basalt/utils/bs_port_dump.h	2026-10-07 00:50:42.186356646 +0200
@@ -0,0 +1,239 @@
+// basalt_port instrumentation (reference build only, never distributed). Observation only: reads estimator state, never writes it.
+//
+// Environment (everything off unless BASALT_PORT_DUMP_DIR is set):
+//   BASALT_PORT_DUMP_DIR=<dir>     writes <dir>/{flow,imu,iter,marg,summary}.bin
+//   BASALT_PORT_DUMP_EVERY="flow=1,imu=1,iter=1,marg=1"   sample every N-th frame (flow/imu) / optimize() call / marginalisation
+//   BASALT_PORT_DUMP_FULL=1        iter and marg records additionally carry the dense H,b,inc / Q2Jp,Q2r,prior,H_new,b_new arrays
+//
+// Framed records: u32 tag, u64 payload bytes, payload (little endian, no padding). Layouts: basalt_port/c/check_bs_dump.c and
+// basalt_port/PLAN.md. S = Scalar of the estimator (float in the reference), matrices are Eigen column major.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+#include <algorithm>
+#include <type_traits>
+
+namespace basalt {
+namespace port {
+
+enum Stream { S_FLOW = 0, S_IMU = 1, S_ITER = 2, S_MARG = 3, S_SUMMARY = 4, S_COUNT = 5 };
+
+// record tags
+enum Tag : uint32_t {
+  T_FLOW = 1,
+  T_IMU_PREINT = 2,
+  T_ITER_STEP = 3,
+  T_MARG = 4,
+  T_IMU_PREDICT = 5,
+  T_OPT_END = 6,
+  T_OPT_BEGIN = 7,
+  T_SUMMARY = 9,
+  T_HDR = 100
+};
+
+// counters of executed paths (always counted, only reported when the dump is on)
+enum Counter {
+  C_FRAMES_MEASURED, C_OPTIMIZE_CALLS, C_OPTIMIZE_RUN, C_LM_STEPS, C_LM_ACCEPTED, C_LM_REJECTED, C_LM_INVALID, C_LDLT_SOLVES,
+  C_LDLT_RETRY, C_MARGINALIZE_CALLS, C_MARG_DONE, C_MARG_SQRT_TO_SQRT, C_MARG_SQ_TO_SQRT, C_MARG_SQ_TO_SQ, C_MARG_KF_DROPS,
+  C_LIN_CREATE_ABS_QR, C_LIN_CREATE_ABS_SC, C_LIN_CREATE_REL_SC, C_LINEARIZE_PROBLEM, C_PERFORM_QR, C_GET_DENSE_Q2JP,
+  C_GET_DENSE_H_B, C_EST_CTOR_FLOAT, C_EST_CTOR_DOUBLE, C_IMU_INTEGRATE, C_IMU_FRAME_PAIRS, C_FLOW_FRAMES,
+  C_LOG_MARG_NULLSPACE, C_NEW_KF, C_LANDMARKS_ADDED, C_COUNTERS
+};
+static const char* const kCounterNames[C_COUNTERS] = {
+    "frames_measured", "optimize_calls", "optimize_run", "lm_steps", "lm_accepted", "lm_rejected", "lm_invalid", "ldlt_solves",
+    "ldlt_retry", "marginalize_calls", "marg_done", "marg_helper_sqrt_to_sqrt", "marg_helper_sq_to_sqrt", "marg_helper_sq_to_sq",
+    "marg_kf_drops", "lin_create_abs_qr", "lin_create_abs_sc", "lin_create_rel_sc", "linearize_problem", "perform_qr",
+    "get_dense_q2jp_q2r", "get_dense_h_b", "est_ctor_float", "est_ctor_double", "imu_integrate", "imu_frame_pairs", "flow_frames",
+    "log_marg_nullspace", "new_kf", "landmarks_added"};
+
+struct Dump {
+  bool on = false;
+  bool full = false;
+  int every[S_COUNT] = {1, 1, 1, 1, 1};
+  uint64_t seen[S_COUNT] = {0, 0, 0, 0, 0};
+  FILE* f[S_COUNT] = {nullptr, nullptr, nullptr, nullptr, nullptr};
+  std::atomic<uint64_t> cnt[C_COUNTERS];
+  std::string dir;
+
+  Dump() {
+    for (auto& c : cnt) c = 0;
+    const char* d = std::getenv("BASALT_PORT_DUMP_DIR");
+    if (!d || !*d) return;
+    dir = d;
+    on = true;
+    if (const char* fl = std::getenv("BASALT_PORT_DUMP_FULL")) full = std::atoi(fl) != 0;
+    if (const char* e = std::getenv("BASALT_PORT_DUMP_EVERY")) {
+      std::string s(e);
+      size_t p = 0;
+      while (p < s.size()) {
+        size_t q = s.find(',', p);
+        if (q == std::string::npos) q = s.size();
+        std::string kv = s.substr(p, q - p);
+        size_t eq = kv.find('=');
+        if (eq != std::string::npos) {
+          std::string k = kv.substr(0, eq);
+          int v = std::atoi(kv.c_str() + eq + 1);
+          if (v < 1) v = 1;
+          if (k == "flow") every[S_FLOW] = v;
+          else if (k == "imu") every[S_IMU] = v;
+          else if (k == "iter") every[S_ITER] = v;
+          else if (k == "marg") every[S_MARG] = v;
+        }
+        p = q + 1;
+      }
+    }
+  }
+  ~Dump() {
+    if (on) {
+      std::vector<uint8_t> b;
+      for (int i = 0; i < C_COUNTERS; i++) {
+        uint32_t n = (uint32_t)std::strlen(kCounterNames[i]);
+        raw(b, &n, 4);
+        raw(b, kCounterNames[i], n);
+        uint64_t v = cnt[i];
+        raw(b, &v, 8);
+      }
+      std::vector<uint8_t> pay;
+      uint32_t nc = C_COUNTERS;
+      raw(pay, &nc, 4);
+      pay.insert(pay.end(), b.begin(), b.end());
+      write(S_SUMMARY, T_SUMMARY, pay);
+    }
+    for (auto* x : f)
+      if (x) std::fclose(x);
+  }
+
+  static void raw(std::vector<uint8_t>& b, const void* p, size_t n) {
+    const uint8_t* c = (const uint8_t*)p;
+    b.insert(b.end(), c, c + n);
+  }
+
+  // true for the first and then every every[s]-th call, per stream
+  bool want(Stream s) {
+    if (!on) return false;
+    bool r = (seen[s] % (uint64_t)every[s]) == 0;
+    seen[s]++;
+    return r;
+  }
+
+  bool wantIdx(Stream s, uint64_t idx) const { return on && (idx % (uint64_t)every[s]) == 0; }
+
+  void write(Stream s, uint32_t tag, const std::vector<uint8_t>& pay) {
+    if (!f[s]) {
+      static const char* names[S_COUNT] = {"flow", "imu", "iter", "marg", "summary"};
+      f[s] = std::fopen((dir + "/" + names[s] + ".bin").c_str(), "wb");
+      if (!f[s]) return;
+      // HDR: u32 version, u32 sizeof(Scalar of estimator)=4 (float reference), u32 every[4], u32 full
+      std::vector<uint8_t> h;
+      uint32_t v[7] = {1, (uint32_t)sizeof(float), (uint32_t)every[0], (uint32_t)every[1], (uint32_t)every[2], (uint32_t)every[3],
+                       (uint32_t)full};
+      raw(h, v, sizeof v);
+      uint32_t t = T_HDR;
+      uint64_t n = h.size();
+      std::fwrite(&t, 4, 1, f[s]);
+      std::fwrite(&n, 8, 1, f[s]);
+      std::fwrite(h.data(), 1, n, f[s]);
+    }
+    uint64_t n = pay.size();
+    std::fwrite(&tag, 4, 1, f[s]);
+    std::fwrite(&n, 8, 1, f[s]);
+    if (n) std::fwrite(pay.data(), 1, n, f[s]);
+    std::fflush(f[s]);
+  }
+};
+
+inline Dump& D() {
+  static Dump d;
+  return d;
+}
+inline void count(Counter c) { D().cnt[c].fetch_add(1, std::memory_order_relaxed); }
+inline void countN(Counter c, uint64_t n) { D().cnt[c].fetch_add(n, std::memory_order_relaxed); }
+
+struct Buf {
+  std::vector<uint8_t> b;
+  void u32(uint32_t v) { Dump::raw(b, &v, 4); }
+  void i32(int32_t v) { Dump::raw(b, &v, 4); }
+  void u64(uint64_t v) { Dump::raw(b, &v, 8); }
+  void i64(int64_t v) { Dump::raw(b, &v, 8); }
+  void f32(float v) { Dump::raw(b, &v, 4); }
+  template <class T>
+  void arr(const T* p, size_t n) { Dump::raw(b, p, n * sizeof(T)); }
+};
+
+// FNV-1a 64 over raw bytes, chainable
+inline uint64_t fnv(const void* p, size_t n, uint64_t h = 1469598103934665603ull) {
+  const uint8_t* c = (const uint8_t*)p;
+  for (size_t i = 0; i < n; i++) {
+    h ^= c[i];
+    h *= 1099511628211ull;
+  }
+  return h;
+}
+template <class T>
+inline uint64_t fnvT(const T& v, uint64_t h) { return fnv(&v, sizeof(T), h); }
+
+template <class Mat>  // dense Eigen matrix/vector, contiguous column major
+inline uint64_t hashMat(const Mat& m) {
+  uint64_t h = fnv(nullptr, 0);
+  int64_t r = m.rows(), c = m.cols();
+  h = fnvT(r, h);
+  h = fnvT(c, h);
+  return fnv(m.data(), sizeof(typename Mat::Scalar) * m.size(), h);
+}
+
+template <class SE3>
+inline void putSE3(Buf& b, const SE3& T) {  // quaternion coeffs (x,y,z,w), translation
+  b.arr(T.unit_quaternion().coeffs().data(), 4);
+  b.arr(T.translation().data(), 3);
+}
+template <class SE3>
+inline uint64_t hashSE3(const SE3& T, uint64_t h) {
+  h = fnv(T.unit_quaternion().coeffs().data(), sizeof(typename SE3::Scalar) * 4, h);
+  return fnv(T.translation().data(), sizeof(typename SE3::Scalar) * 3, h);
+}
+
+// digest of all frame poses and frame states (current + linearisation point + delta + lin flag)
+template <class Poses, class States>
+inline uint64_t stateDigest(const Poses& poses, const States& states) {
+  uint64_t h = fnv(nullptr, 0);
+  for (const auto& kv : poses) {
+    int64_t k = kv.first;
+    h = fnvT(k, h);
+    uint8_t lin = kv.second.isLinearized();
+    h = fnvT(lin, h);
+    h = hashSE3(kv.second.getPose(), h);
+    h = hashSE3(kv.second.getPoseLin(), h);
+    h = fnv(kv.second.getDelta().data(), sizeof(typename std::decay_t<decltype(kv.second.getDelta())>::Scalar) * 6, h);
+  }
+  for (const auto& kv : states) {
+    int64_t k = kv.first;
+    h = fnvT(k, h);
+    uint8_t lin = kv.second.isLinearized();
+    h = fnvT(lin, h);
+    for (const auto* s : {&kv.second.getState(), &kv.second.getStateLin()}) {
+      h = hashSE3(s->T_w_i, h);
+      h = fnv(s->vel_w_i.data(), sizeof(s->vel_w_i(0)) * 3, h);
+      h = fnv(s->bias_gyro.data(), sizeof(s->bias_gyro(0)) * 3, h);
+      h = fnv(s->bias_accel.data(), sizeof(s->bias_accel(0)) * 3, h);
+    }
+    h = fnv(kv.second.getDelta().data(), sizeof(typename std::decay_t<decltype(kv.second.getDelta())>::Scalar) * 15, h);
+  }
+  return h;
+}
+
+template <class State>  // PoseVelBiasState: quat(4) p(3) v(3) bg(3) ba(3)
+inline void putState(Buf& b, const State& s) {
+  putSE3(b, s.T_w_i);
+  b.arr(s.vel_w_i.data(), 3);
+  b.arr(s.bias_gyro.data(), 3);
+  b.arr(s.bias_accel.data(), 3);
+}
+
+}  // namespace port
+}  // namespace basalt
