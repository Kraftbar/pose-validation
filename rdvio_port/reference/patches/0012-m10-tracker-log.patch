+    b.f64n(p.jacobian.dq_dbg.data(), 9); b.f64n(p.jacobian.dp_dbg.data(), 9); b.f64n(p.jacobian.dp_dba.data(), 9);
+    b.f64n(p.jacobian.dv_dbg.data(), 9); b.f64n(p.jacobian.dv_dba.data(), 9);
+    b.u64(p.data.size());
