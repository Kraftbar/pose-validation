+}
+void port_frame(PortBuf &b, const rdvio::Frame *f, bool full) {
+    b.u64(f->id()); b.u32(port_ftags(f));
+    b.f64n(f->pose.q.coeffs().data(), 4); b.f64n(f->pose.p.data(), 3);
+    b.f64n(f->motion.v.data(), 3); b.f64n(f->motion.bg.data(), 3); b.f64n(f->motion.ba.data(), 3);
+    if (!full) return;
+    b.f64(f->image->t); b.f64n(f->K.data(), 9); b.f64n(f->sqrt_inv_cov.data(), 4);
+    b.f64n(f->camera.q_cs.coeffs().data(), 4); b.f64n(f->camera.p_cs.data(), 3);
+    b.f64n(f->imu.q_cs.coeffs().data(), 4); b.f64n(f->imu.p_cs.data(), 3);
+    port_pre(b, f->preintegration);
+    port_pre(b, f->keyframe_preintegration);
+    b.u64(f->keypoint_num());
+    for (size_t k = 0; k < f->keypoint_num(); ++k) {
+        b.f64n(f->get_keypoint(k).data(), 3);
+        const rdvio::Track *t = f->get_track(k);
+        b.u64(t ? t->id() : 0u);
+    }
+}
+/* the window: map frames, each followed by its subframes; the map's tracks in map order, references by frame id */
+void port_window(PortBuf &b, rdvio::Map *map, bool full) {
+    using namespace rdvio;
+    b.u64(map->frame_num());
+    for (size_t i = 0; i < map->frame_num(); ++i) {
+        Frame *f = map->get_frame(i);
+        port_frame(b, f, full);
+        b.u64(f->subframes.size());
+        for (const auto &s : f->subframes) port_frame(b, s.get(), full);
+    }
+    b.u64(map->track_num());
+    for (size_t i = 0; i < map->track_num(); ++i) {
+        Track *t = map->get_track(i);
+        b.u64(t->id()); b.u32(port_ttags(t)); b.f64(t->landmark.inv_depth); b.u64(t->m_life);
+        b.u64(t->keypoint_map().size());
+        for (const auto &[fr, kp] : t->keypoint_map()) { b.u64(fr->id()); b.u64(kp); }
+    }
+}
+void port_marg(PortBuf &b, rdvio::Map *map) {
+    const rdvio::MarginalizationFactor *m = map->marginalization_factor.get();
+    b.u32(m ? 1u : 0u);
+    if (!m) return;
+    const auto &fr = m->linearization_frames();
+    b.u64(fr.size());
+    for (size_t i = 0; i < fr.size(); ++i) {
+        b.u64(fr[i]->id());
+        const auto &p = PortMargAccess::lp(*m)[i];
+        const auto &v = PortMargAccess::lm(*m)[i];
+        b.f64n(p.q.coeffs().data(), 4); b.f64n(p.p.data(), 3);
+        b.f64n(v.v.data(), 3); b.f64n(v.bg.data(), 3); b.f64n(v.ba.data(), 3);
+    }
+    b.f64n(PortMargAccess::sic(*m).data(), (size_t)PortMargAccess::sic(*m).size());
+    b.f64n(PortMargAccess::iv(*m).data(), (size_t)PortMargAccess::iv(*m).size());
+}
+/* the feature-tracking frame with the current frame's id (update_track_status's old_frame): per keypoint 0 = no track,
+   1 = track, 3 = track with TT_STATIC. Found by a plain scan (frame_index_by_id would add an event to the M6 log). */
+void port_ft(PortBuf &b, rdvio::Map *ft, uint64_t id) {
+    rdvio::Frame *of = nullptr;
+    if (ft) for (size_t i = 0; i < ft->frame_num(); ++i) if (ft->get_frame(i)->id() == id) { of = ft->get_frame(i); break; }
+    b.u32(of ? 1u : 0u);
+    if (!of) return;
+    b.u64(of->keypoint_num());
+    for (size_t k = 0; k < of->keypoint_num(); ++k) {
+        const rdvio::Track *t = of->get_track(k);
+        b.u32(t ? (t->tag(rdvio::TT_STATIC) ? 3u : 1u) : 0u);
+    }
+}
