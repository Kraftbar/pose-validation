+// rdvio_port instrumentation (reference build only, never distributed): the sliding-window tracker log of module M10,
+// RDVIO_PORT_SWT_DIR (writes <dir>/swt.bin). Logged track() calls: the first RDVIO_PORT_SWT_ALL (default 0), then every
+// RDVIO_PORT_SWT_EVERY-th (default 1). Stage records carry the FNV-1a 64 hash of their payload, and the payload itself
+// with RDVIO_PORT_SWT_FULL=1. RDVIO_PORT_SWT_MASKS=1: only the PARSAC mask records (5, 6) of every call (the input of the
+// C system driver until the estimators are ported).
+// Framed records: u32 tag, u64 bytes, payload. Layouts in rdvio_port/c/check_rd_swt.c. Observation only.
+namespace {
+struct PortSwt {
+    FILE *f = nullptr;
+    bool checked = false, on = false;
+    long every = 1, all = 0, calls = 0;
+    bool full = false, masks = false;
+    FILE *get() {
+        if (!checked) {
+            checked = true;
+            if (const char *d = std::getenv("RDVIO_PORT_SWT_DIR")) f = std::fopen((std::string(d) + "/swt.bin").c_str(), "wb");
+            if (const char *e = std::getenv("RDVIO_PORT_SWT_EVERY")) every = std::max(1L, std::atol(e));
+            if (const char *e = std::getenv("RDVIO_PORT_SWT_ALL")) all = std::atol(e);
+            if (const char *e = std::getenv("RDVIO_PORT_SWT_FULL")) full = std::atol(e) != 0;
+            if (const char *e = std::getenv("RDVIO_PORT_SWT_MASKS")) masks = std::atol(e) != 0;
+        }
+        return f;
+    }
+} g_port_swt;
+struct PortBuf {
+    std::vector<unsigned char> b;
+    void raw(const void *p, size_t n) { const unsigned char *c = (const unsigned char *)p; b.insert(b.end(), c, c + n); }
+    void u32(uint32_t v) { raw(&v, 4); }
+    void u64(uint64_t v) { raw(&v, 8); }
+    void f64(double v) { raw(&v, 8); }
+    void f64n(const double *p, size_t n) { raw(p, 8 * n); }
+    void write(uint32_t tag) {
+        FILE *f = g_port_swt.get();
+        if (!f || !g_port_swt.on) return;
+        uint64_t n = b.size();
+        std::fwrite(&tag, 4, 1, f); std::fwrite(&n, 8, 1, f);
+        if (n) std::fwrite(b.data(), 1, n, f);
+        std::fflush(f);
+    }
+    /* a stage record: u64 FNV-1a 64 of the payload, then the payload if RDVIO_PORT_SWT_FULL */
+    void write_stage(uint32_t tag) {
+        uint64_t h = 1469598103934665603ull;
+        for (unsigned char c : b) { h ^= c; h *= 1099511628211ull; }
+        PortBuf o; o.u64(h);
+        if (g_port_swt.full) o.raw(b.data(), b.size());
+        o.write(tag);
+    }
+};
+uint32_t port_ftags(const rdvio::Frame *f) {
+    uint32_t t = 0;
+    for (int k = 0; k <= (int)rdvio::FT_FIX_MOTION; ++k) if (f->tag((rdvio::FrameTag)k)) t |= 1u << k;
+    return t;
+}
+uint32_t port_ttags(const rdvio::Track *tr) {
+    uint32_t t = 0;
+    for (int k = 0; k <= (int)rdvio::TT_TEMP; ++k) if (tr->tag((rdvio::TrackTag)k)) t |= 1u << k;
+    return t;
+}
+/* the protected state of the marginalization factor, read through member pointers (no access to anything else) */
+struct PortMargAccess : rdvio::MarginalizationFactor {
+    typedef rdvio::MarginalizationFactor MF;
+    static const std::vector<rdvio::PoseState> &lp(const MF &m) { return m.*(&PortMargAccess::pose_linearization_point); }
+    static const std::vector<rdvio::MotionState> &lm(const MF &m) { return m.*(&PortMargAccess::motion_linearization_point); }
+    static const rdvio::matrix<> &sic(const MF &m) { return m.*(&PortMargAccess::sqrt_inv_cov); }
+    static const rdvio::vector<> &iv(const MF &m) { return m.*(&PortMargAccess::infovec); }
+};
+void port_pre(PortBuf &b, const rdvio::PreIntegrator &p) {
+    b.f64n(p.cov_w.data(), 9); b.f64n(p.cov_a.data(), 9); b.f64n(p.cov_bg.data(), 9); b.f64n(p.cov_ba.data(), 9);
+    b.f64(p.delta.t); b.f64n(p.delta.q.coeffs().data(), 4); b.f64n(p.delta.p.data(), 3); b.f64n(p.delta.v.data(), 3);
