+/* every live map (ascending serial): frames (object, id, track id per keypoint) and tracks in vector order (id, map_index, the
+ * keypoint references, m_life, tag bits, inverse depth) */
+void Map::port_digest() {
+    if (!portmap::on()) return;
+    static uint64_t calls = 0, every = std::getenv("RDVIO_PORT_MAP_DIGEST_EVERY") ? std::strtoull(std::getenv("RDVIO_PORT_MAP_DIGEST_EVERY"), nullptr, 10) : 1;
+    if (every == 0 || calls++ % every != 0) return;
+    portmap::Log &l = portmap::log();
+    portmap::Rec r(portmap::DIGEST);
+    r.u32((uint32_t)l.map_by_serial.size());
+    for (const auto &[serial, mp] : l.map_by_serial) {
+        const Map *m = (const Map *)mp;
+        r.u32(serial).u64(m->frames.size());
+        for (const auto &f : m->frames) {
+            r.u32(portmap::frame_serial(f.get())).u64(f->id()).u64(f->tracks.size());
+            for (const Track *t : f->tracks) r.u64(t ? t->id() : 0u);
+        }
+        r.u64(m->tracks.size());
+        for (const auto &t : m->tracks) {
+            uint32_t tags = 0;
+            for (int k = 0; k <= (int)TT_TEMP; ++k) if (t->tag((TrackTag)k)) tags |= 1u << k;
+            r.u64(t->id()).u64(t->map_index).u64(t->keypoint_refs.size());
+            for (const auto &[fr, kp] : t->keypoint_refs) r.u32(portmap::frame_serial(fr)).u64(kp);
+            r.u64(t->m_life).u32(tags).f64(t->landmark.inv_depth);
+        }
+    }
+}
+
 } // namespace rdvio
