diff -ruN a/src/rdvio_map/include/rdvio/map/port_maplog.h b/src/rdvio_map/include/rdvio/map/port_maplog.h
--- a/src/rdvio_map/include/rdvio/map/port_maplog.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/rdvio_map/include/rdvio/map/port_maplog.h	2026-10-06 10:13:10.429906863 +0200
@@ -0,0 +1,58 @@
+#pragma once
+// rdvio_port instrumentation (reference build only, never distributed): the map-layer mutation log of module M6.
+// Enabled by RDVIO_PORT_MAP_DIR (writes <dir>/map.bin). Pure observation: reads state, never modifies it.
+// Framed records: u32 tag, u32 payload bytes, payload (native endian). Layouts: rdvio_port/c/rd_map.h.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <vector>
+namespace rdvio {
+namespace portmap {
+enum : uint32_t {
+    MAPNEW = 1, MAPDEL, FRAMENEW, FRAMEDEL, ATTACH, DETACH, UNTRACK, ERASEFRAME, MARGFRAME, FIDX, CREATETRACK, ERASETRACK, PRUNE,
+    RECYCLE, ADDKP, RMKP, APPENDKP, DETECT, TRACKKP, DIGEST
+};
+struct Log {
+    FILE *f = nullptr;
+    bool checked = false;
+    uint32_t next_map = 0, next_frame = 0;
+    std::map<const void *, uint32_t> maps, frames;   // live object -> serial
+    std::map<uint32_t, const void *> map_by_serial;  // ascending serial (digest order)
+};
+inline Log &log() {
+    static Log l;
+    if (!l.checked) {
+        l.checked = true;
+        if (const char *d = std::getenv("RDVIO_PORT_MAP_DIR")) l.f = std::fopen((std::string(d) + "/map.bin").c_str(), "wb");
+    }
+    return l;
+}
+inline bool on() { return log().f != nullptr; }
+struct Rec {
+    uint32_t tag;
+    std::vector<unsigned char> b;
+    explicit Rec(uint32_t t) : tag(t) {}
+    Rec &raw(const void *p, size_t n) { const unsigned char *c = (const unsigned char *)p; b.insert(b.end(), c, c + n); return *this; }
+    Rec &u32(uint32_t v) { return raw(&v, 4); }
+    Rec &u64(uint64_t v) { return raw(&v, 8); }
+    Rec &f64(double v) { return raw(&v, 8); }
+    Rec &f64n(const double *p, size_t n) { return raw(p, 8 * n); }
+    ~Rec() {
+        Log &l = log();
+        if (!l.f) return;
+        uint32_t n = (uint32_t)b.size();
+        std::fwrite(&tag, 4, 1, l.f); std::fwrite(&n, 4, 1, l.f);
+        if (n) std::fwrite(b.data(), 1, n, l.f);
+    }
+};
+inline uint32_t map_serial(const void *m) { auto &s = log().maps; auto it = s.find(m); return it == s.end() ? 0u : it->second; }
+inline uint32_t frame_serial(const void *f) { auto &s = log().frames; auto it = s.find(f); return it == s.end() ? 0u : it->second; }
+inline uint32_t new_map(const void *m) { Log &l = log(); const uint32_t s = ++l.next_map; l.maps[m] = s; l.map_by_serial[s] = m; return s; }
+inline void del_map(const void *m) { Log &l = log(); auto it = l.maps.find(m); if (it != l.maps.end()) { l.map_by_serial.erase(it->second); l.maps.erase(it); } }
+inline uint32_t new_frame(const void *f) { Log &l = log(); const uint32_t s = ++l.next_frame; l.frames[f] = s; return s; }
+inline void del_frame(const void *f) { log().frames.erase(f); }
+inline void flush() { if (log().f) std::fflush(log().f); }
+} // namespace portmap
+} // namespace rdvio
