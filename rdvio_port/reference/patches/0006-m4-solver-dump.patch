+void port_live(rp::Buf &b, const double *p, int n) { b.u64((uint64_t)(uintptr_t)p); b.u32((uint32_t)n); b.f64n(p, (size_t)n); }
+void port_extr(rp::Buf &b, const ExtrinsicParams &e) { b.f64n(e.q_cs.coeffs().data(), 4); b.f64n(e.p_cs.data(), 3); }
+void port_vis(rp::Buf &b, const CeresReprojectionErrorFactor &f) {
