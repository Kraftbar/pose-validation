+bool port_solve_enabled() {
+    static int init = 0;
+    if (!init) {
+        init = 1;
+        if (const char *d = std::getenv("RDVIO_PORT_SOLVE_DUMP_DIR")) {
+            std::string path = std::string(d) + "/solve.bin";
+            rp::g.f = std::fopen(path.c_str(), "wb");
+            rp::g.enabled = rp::g.f != nullptr;
+        }
+    }
+    return rp::g.enabled;
+}
+uint64_t port_env(const char *name, uint64_t def) {
