+#pragma once
+// rdvio_port instrumentation (reference build only, never distributed): binary record dumps used by rdvio_port/c/check_rd_*.c.
+// Enabled by RDVIO_PORT_DUMP_DIR; sampling by RDVIO_PORT_DUMP_EVERY="integ=1,pred=1,pie=20,plus=50" (0 = count only).
+// Pure observation: reads state, never modifies it.
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+namespace rdvio {
+namespace portdump {
+struct Chan {
+    FILE *f = nullptr;
+    uint64_t count = 0, every = 1;
+    const char *name;
+};
+inline Chan &chan(int k) {
+    static Chan ch[4] = {{nullptr, 0, 1, "integ"}, {nullptr, 0, 1, "pred"}, {nullptr, 0, 20, "pie"}, {nullptr, 0, 50, "plus"}};
+    static bool init = false;
+    if (!init) {
+        init = true;
+        if (const char *e = std::getenv("RDVIO_PORT_DUMP_EVERY")) {
+            std::string s(e);
+            for (auto &c : ch) {
+                size_t p = s.find(std::string(c.name) + "=");
+                if (p != std::string::npos) c.every = std::strtoull(s.c_str() + p + strlen(c.name) + 1, nullptr, 10);
+            }
+        }
+    }
+    return ch[k];
+}
+// returns the open channel if this call is to be recorded, else nullptr
+inline Chan *want(int k) {
+    const char *dir = std::getenv("RDVIO_PORT_DUMP_DIR");
+    if (!dir) return nullptr;
+    Chan &c = chan(k);
+    uint64_t n = c.count++;
+    if (c.every == 0 || n % c.every != 0) return nullptr;
+    if (!c.f) {
+        std::string p = std::string(dir) + "/" + c.name + ".bin";
+        c.f = std::fopen(p.c_str(), "wb");
+    }
+    return c.f ? &c : nullptr;
+}
+inline void u32(Chan *c, uint32_t v) { std::fwrite(&v, 4, 1, c->f); }
+inline void f64(Chan *c, const double *p, size_t n) { std::fwrite(p, 8, n, c->f); }
+inline void f64(Chan *c, double v) { std::fwrite(&v, 8, 1, c->f); }
+inline void flush_all() {
+    for (int k = 0; k < 4; ++k)
+        if (chan(k).f) std::fflush(chan(k).f);
+}
+struct Flusher {
+    ~Flusher() { flush_all(); }
+};
+inline thread_local bool via_prior = false;
+} // namespace portdump
+} // namespace rdvio
