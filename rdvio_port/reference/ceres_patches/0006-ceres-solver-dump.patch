+    const CompressedRowSparseMatrix* jtj = inner_product_computer_->mutable_result();
+    okb.u32(uint32_t(num_cols)); okb.u32(uint32_t(jtj->num_nonzeros())); okb.u32(uint32_t(jtj->storage_type()));
+    okb.u32(uint32_t(sparse_cholesky_->StorageType()));
+    okb.u64(rdvio_port_solve::fnvd(jtj->values(), size_t(jtj->num_nonzeros())));
+    okb.u64(rdvio_port_solve::fnvd(rhs_.data(), size_t(num_cols)));
+    okb.u64(rdvio_port_solve::fnv(jtj->rows(), 4 * (size_t(jtj->num_rows()) + 1)));
+    okb.u64(rdvio_port_solve::fnv(jtj->cols(), 4 * size_t(jtj->num_nonzeros())));
+    if (rdvio_port_solve::g.on(2)) {
+      okb.i32n(jtj->rows(), size_t(jtj->num_rows()) + 1); okb.i32n(jtj->cols(), size_t(jtj->num_nonzeros()));
+      okb.f64n(jtj->values(), size_t(jtj->num_nonzeros())); okb.f64n(rhs_.data(), size_t(num_cols));
+    }
+  }
   summary.termination_type = sparse_cholesky_->FactorAndSolve(
       inner_product_computer_->mutable_result(),
       rhs_.data(),
       x,
       &summary.message);
+  if (okon) {
+    okb.u32(uint32_t(summary.termination_type));
+    const bool ok = summary.termination_type == LinearSolverTerminationType::SUCCESS;
+    okb.u64(ok ? rdvio_port_solve::fnvd(x, size_t(num_cols)) : 0ULL);
+    if (ok && rdvio_port_solve::g.on(2)) okb.f64n(x, size_t(num_cols));
+    rdvio_port_solve::g.write(rdvio_port_solve::R_SPARSE, okb);
+  }
   event_logger.AddEvent("SparseCholesky::FactorAndSolve");
   return summary;
 }
