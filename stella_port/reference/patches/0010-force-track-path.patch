+namespace {
+// [reference-port] patch 0010: OPT-IN fault injection, DEFAULT OFF. Only when
+// the environment variable STELLA_PORT_FORCE_PATH is set ("bow:N" or
+// "robust:N"), every N-th frame (frame id % N == 0) skips the motion-model
+// tracker ("bow:N") or the motion-model and BoW trackers ("robust:N"), so the
+// otherwise unreachable frame_tracker paths run on real data. Used only to
+// produce alternative dumps (runs/stella_port/reference_dumps_force_*) for
+// exercising the port; the canonical reference dumps never set it.
+struct force_path_cfg {
+    int mode = 0;
+    unsigned int period = 0;
+};
+force_path_cfg parse_force_path() {
+    force_path_cfg cfg;
+    const char* env = std::getenv("STELLA_PORT_FORCE_PATH");
+    if (!env) {
+        return cfg;
+    }
+    const std::string s(env);
+    const auto colon = s.find(':');
+    if (colon == std::string::npos) {
+        return cfg;
+    }
+    const std::string kind = s.substr(0, colon);
+    cfg.period = static_cast<unsigned int>(std::atoi(s.c_str() + colon + 1));
+    cfg.mode = (kind == "bow") ? 1 : (kind == "robust") ? 2 : 0;
+    return cfg;
+}
