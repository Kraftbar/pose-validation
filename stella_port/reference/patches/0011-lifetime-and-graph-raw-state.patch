+    for (const auto& kv : connected_keyfrms_and_num_shared_lms_) {
+        const auto kf = kv.first.lock();
+        connected.emplace_back(kf ? static_cast<int>(kf->id_) : -1, kv.second);
+    }
+    for (size_t i = 0; i < ordered_covisibilities_.size(); ++i) {
+        const auto kf = ordered_covisibilities_.at(i).lock();
+        ordered.emplace_back(kf ? static_cast<int>(kf->id_) : -1, ordered_num_shared_lms_.at(i));
+    }
