+void graph_node::get_raw_state(std::vector<std::pair<int, unsigned int>>& connected, std::vector<std::pair<int, unsigned int>>& ordered) const { // [reference-port] patch 0011
+    std::lock_guard<std::mutex> lock(mtx_);
+    connected.clear();
