+#ifndef STELLA_VSLAM_UTIL_ERASURE_LOG_H
+#define STELLA_VSLAM_UTIL_ERASURE_LOG_H
+
+// [reference-port] Hooks at data::keyframe::prepare_for_erasing() and
+// data::landmark::prepare_for_erasing()/replace() append a snapshot of the
+// object's live state here, right before that state is torn down. A driver
+// can read+clear these every frame to get erased.tsv (see
+// stella_port/reference/README.md "Dumps") -- otherwise an erased
+// keyframe/landmark simply vanishes from map_publisher::get_keyframes()/
+// get_landmarks() with no record of what it looked like, which is not
+// enough for a port to rebuild dangling references the way stella_vslam's
+// own runtime does (erased objects stay referenced by shared_ptr from
+// wherever last held one, e.g. curr_frm_/last_frm_, and can still be
+// queried until the last reference drops).
+//
+// Global, not per-object: erasure can be triggered from many call sites
+// (module::local_map_cleaner, optimize::local_bundle_adjuster_g2o's
+// outlier removal via landmark::erase_observation, mapping_module's
+// erase_temporal_keyframes_, landmark::replace(), ...) and goal is one
+// combined log of "everything erased", not one log per caller.
+
+#include "stella_vslam/type.h"
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+namespace stella_vslam {
+namespace util {
+
+struct erased_landmark_record {
+    unsigned int id = 0;
+    Vec3_t pos_w = Vec3_t::Zero();
+    //! representative descriptor bytes (empty if it never had one)
+    std::vector<uint8_t> descriptor;
+    Vec3_t mean_normal = Vec3_t::Zero();
+    float min_valid_dist = 0.f;
+    float max_valid_dist = 0.f;
+    //! (keyframe id, keypoint idx), snapshot of observations_ before it was cleared
+    std::vector<std::pair<unsigned int, unsigned int>> observations;
+    unsigned int num_observed = 0;
+    unsigned int num_observable = 0;
+    int ref_keyfrm_id = -1; // -1 if ref_keyfrm_ was already expired
+    //! id of the landmark this one was merged into, or -1 if this was a
+    //! plain cull (not a replace())
+    int replaced_by_id = -1;
+};
+
+struct erased_keyframe_record {
+    unsigned int id = 0;
+    Mat44_t pose_cw = Mat44_t::Identity();
+    //! (covisibility keyframe id, weight), graph_node_->get_covisibilities()
+    //! order, snapshot before erase_all_connections()
+    std::vector<std::pair<unsigned int, unsigned int>> covisibilities;
+    int spanning_parent_id = -1;
+    std::vector<unsigned int> spanning_children_ids;
+};
+
+extern std::vector<erased_landmark_record> g_erased_landmarks;
+extern std::vector<erased_keyframe_record> g_erased_keyframes;
+
+} // namespace util
+} // namespace stella_vslam
+
+#endif // STELLA_VSLAM_UTIL_ERASURE_LOG_H
--- /dev/null
+++ b/src/stella_vslam/util/erasure_log.cc
@@ -0,0 +1,10 @@
+#include "stella_vslam/util/erasure_log.h"
+
+namespace stella_vslam {
+namespace util {
+
+std::vector<erased_landmark_record> g_erased_landmarks;
+std::vector<erased_keyframe_record> g_erased_keyframes;
+
+} // namespace util
+} // namespace stella_vslam
