diff -ruN a/src/stella_vslam/util/loop_trace.h b/src/stella_vslam/util/loop_trace.h
--- a/src/stella_vslam/util/loop_trace.h
+++ b/src/stella_vslam/util/loop_trace.h
@@ -0,0 +1,76 @@
+#ifndef STELLA_VSLAM_UTIL_LOOP_TRACE_H
+#define STELLA_VSLAM_UTIL_LOOP_TRACE_H
+
+// [reference-port] patch 0013 (module 7, loop closing). Dump-only, opt-in:
+// nothing here is executed unless the driver sets g_loop_trace to an open
+// FILE*. Text format: one event per line,
+//   <step>\t<TAG>\t<fields...>
+// numbers are exact (%a for doubles; float values are widened first), ids are
+// decimal, lists are comma separated ("idx:id" for keypoint -> landmark
+// associations). <step> is g_loop_step_index, which
+// global_optimization_module::run_step() increments once per dequeued keyframe.
+
+#include "stella_vslam/type.h"
+#include "stella_vslam/data/keyframe.h"
+#include "stella_vslam/data/landmark.h"
+
+#include <g2o/types/sim3/sim3.h>
+
+#include <cstdio>
+#include <functional>
+#include <memory>
+#include <vector>
+
+namespace stella_vslam {
+namespace util {
+
+extern std::FILE* g_loop_trace;                 // nullptr = tracing off
+extern unsigned int g_loop_step_index;          // 1-based index of the global-optimization step
+extern int g_loop_frame_idx;                    // set by the driver before each feed
+extern std::function<void(int)> g_loop_hook;    // phase 0 = before the step, 1 = after the pose graph, 2 = after an accepted loop
+
+inline bool lt_on() { return g_loop_trace != nullptr; }
+inline void lt_start(const char* tag) { std::fprintf(g_loop_trace, "%u\t%s", g_loop_step_index, tag); }
+inline void lt_end() { std::fputc('\n', g_loop_trace); }
+inline void lt_u(unsigned long v) { std::fprintf(g_loop_trace, "\t%lu", v); }
+inline void lt_i(long v) { std::fprintf(g_loop_trace, "\t%ld", v); }
+inline void lt_d(double v) { std::fprintf(g_loop_trace, "\t%a", v); }
+inline void lt_ids(const std::vector<int>& v) {
+    std::fputc('\t', g_loop_trace);
+    for (size_t i = 0; i < v.size(); ++i) {
+        std::fprintf(g_loop_trace, "%s%d", i ? "," : "", v[i]);
+    }
+}
+inline void lt_vec3(const Vec3_t& v) {
+    for (int i = 0; i < 3; ++i) lt_d(v(i));
+}
+inline void lt_mat33(const Mat33_t& m) { // row-major
+    for (int r = 0; r < 3; ++r)
+        for (int c = 0; c < 3; ++c) lt_d(m(r, c));
+}
+inline void lt_mat44(const Mat44_t& m) { // row-major
+    for (int r = 0; r < 4; ++r)
+        for (int c = 0; c < 4; ++c) lt_d(m(r, c));
+}
+inline void lt_sim3(const g2o::Sim3& s) { // qx qy qz qw tx ty tz scale
+    const auto& q = s.rotation().coeffs();
+    for (int i = 0; i < 4; ++i) lt_d(q(i));
+    lt_vec3(s.translation());
+    lt_d(s.scale());
+}
+inline int lt_kid(const std::shared_ptr<data::keyframe>& k) { return k ? static_cast<int>(k->id_) : -1; }
+// keypoint -> landmark association vector as "idx:landmark_id" of the non-null entries
+inline void lt_assoc(const std::vector<std::shared_ptr<data::landmark>>& v) {
+    std::fputc('\t', g_loop_trace);
+    bool first = true;
+    for (size_t i = 0; i < v.size(); ++i) {
+        if (!v[i]) continue;
+        std::fprintf(g_loop_trace, "%s%zu:%u", first ? "" : ",", i, v[i]->id_);
+        first = false;
+    }
+}
+
+} // namespace util
+} // namespace stella_vslam
+
+#endif // STELLA_VSLAM_UTIL_LOOP_TRACE_H
