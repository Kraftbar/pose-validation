+// [reference-port] (patch 0009) keyframe_inserter::create_new_keyframe()
+// records, right after keyfrm->update_landmarks(), the new keyframe's own
+// derived pose fields and the post-update state of every (non-erased)
+// landmark it observes (add_observation + update_mean_normal_and_obs_scale_
+// variance + compute_descriptor). One record per created keyframe; the
+// driver reads and clears g_kf_inserts after each feed.
+struct kf_insert_landmark_record {
+    unsigned int kp_idx = 0;
+    unsigned int id = 0;
+    Vec3_t pos_w = Vec3_t::Zero();
+    std::vector<uint8_t> descriptor;
+    Vec3_t mean_normal = Vec3_t::Zero();
+    float min_valid_dist = 0.f;
+    float max_valid_dist = 0.f;
+    unsigned int num_observations = 0;
+    unsigned int num_observed = 0;
+    unsigned int num_observable = 0;
+    int ref_keyfrm_id = -1;
+};
+
+struct kf_insert_record {
+    unsigned int keyfrm_id = 0;
+    double timestamp = 0.0;
+    Mat44_t pose_cw = Mat44_t::Identity();
+    Mat44_t pose_wc = Mat44_t::Identity();
+    Vec3_t trans_wc = Vec3_t::Zero();
+    std::vector<kf_insert_landmark_record> landmarks;
+};
+
+extern std::vector<kf_insert_record> g_kf_inserts;
+
 } // namespace util
 } // namespace stella_vslam
 
