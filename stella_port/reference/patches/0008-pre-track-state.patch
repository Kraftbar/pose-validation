+// [reference-port] (patch 0008) see tracking_module.h pre_track_state
+tracking_module::pre_track_state tracking_module::get_pre_track_state() const {
+    pre_track_state s;
+    s.tracking_state = static_cast<int>(tracking_state_);
+    s.twist_is_valid = twist_is_valid_;
+    s.twist = twist_;
+    s.last_cam_pose_from_ref_keyfrm = last_cam_pose_from_ref_keyfrm_;
+    s.last_reloc_frm_id = last_reloc_frm_id_;
+    s.last_reloc_frm_timestamp = last_reloc_frm_timestamp_;
+    s.last_frm_pose_valid = last_frm_.pose_is_valid();
+    if (s.last_frm_pose_valid) {
+        s.last_frm_pose_cw = last_frm_.get_pose_cw();
+    }
+    s.last_frm_id = last_frm_.frm_obs_.undist_keypts_.empty() ? -1 : static_cast<long long>(last_frm_.id_);
+    s.last_frm_ref_keyfrm_id = last_frm_.ref_keyfrm_ ? static_cast<long long>(last_frm_.ref_keyfrm_->id_) : -1;
+    uint64_t h = 1469598103934665603ULL;
+    for (unsigned int idx = 0; idx < last_frm_.frm_obs_.undist_keypts_.size(); ++idx) {
+        const auto& lm = last_frm_.get_landmark(idx);
+        if (!lm) {
+            continue;
+        }
+        ++s.last_frm_num_landmarks;
+        const uint64_t vals[2] = {idx, lm->id_};
+        for (int k = 0; k < 2; ++k) {
+            h ^= vals[k];
+            h *= 1099511628211ULL;
+        }
+    }
+    s.last_frm_landmark_hash = h;
+    const auto lik = map_db_->get_last_inserted_keyframe();
+    if (lik) {
+        s.last_inserted_keyfrm_id = lik->id_;
+        s.last_inserted_keyfrm_timestamp = lik->timestamp_;
+        s.last_inserted_keyfrm_trans_wc = lik->get_trans_wc();
+    }
+    s.num_keyframes = map_db_->get_num_keyframes();
+    s.fixed_keyframe_id_threshold = map_db_->get_fixed_keyframe_id_threshold();
+    return s;
+}
