+// okvis_port (patch 0011): serialisation helpers of the backend entry records
+namespace {
+inline void portPutSet(okvis_portv::Buf& b, const std::set<okvis::StateId>& s) {
+  b.u32(uint32_t(s.size()));
+  for (const auto& id : s) b.u64(id.value());
+}
+inline void portPutCamHeader(okvis_portv::Buf& b, const okvis::cameras::CameraBase* g) {
+  using namespace okvis::cameras;
+  if (auto p = dynamic_cast<const PinholeCamera<RadialTangentialDistortion>*>(g)) { p->portHeader(b); return; }
+  if (auto p = dynamic_cast<const PinholeCamera<EquidistantDistortion>*>(g)) { p->portHeader(b); return; }
+  if (auto p = dynamic_cast<const PinholeCamera<NoDistortion>*>(g)) { p->portHeader(b); return; }
+  b.u32(99u);  // unsupported geometry
+}
+inline void portPutMultiFrame(okvis_portv::Buf& b, const okvis::MultiFramePtr& mf) {
+  const size_t nc = mf->numFrames();
+  b.u32(uint32_t(nc));
+  for (size_t i = 0; i < nc; ++i) {
+    okvis_portv::Buf h;
+    portPutCamHeader(h, mf->geometry(i).get());
+    b.u32(uint32_t(h.b.size())); b.raw(h.b.data(), h.b.size());
+    okvis_portv::putT(b, *mf->T_SC(i));
+    b.u32(uint32_t(mf->image(i).rows)); b.u32(uint32_t(mf->image(i).cols));
+    const size_t nk = mf->numKeypoints(i);
+    b.u32(uint32_t(nk));
+    uint32_t nz = 0;
+    cv::KeyPoint kp;
+    for (size_t k = 0; k < nk; ++k) {
+      mf->getCvKeypoint(i, k, kp);
+      const float v[3] = {kp.pt.x, kp.pt.y, kp.size};
+      b.raw(v, 12);
+      if (mf->landmarkId(i, k) != 0) ++nz;
+    }
+    b.u32(nz);
+    for (size_t k = 0; k < nk; ++k) if (mf->landmarkId(i, k) != 0) { b.u32(uint32_t(k)); b.u64(mf->landmarkId(i, k)); }
+  }
+}
