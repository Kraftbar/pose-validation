--- a/okvis_ceres/include/okvis/ceres/OkvisPortVigraphLog.hpp
+++ b/okvis_ceres/include/okvis/ceres/OkvisPortVigraphLog.hpp
@@ -80,5 +80,40 @@ class Scope {
   bool on_ = false, top_ = false;
 };
 
+// ---- patch 0011 (module M6): ViSlamBackend entry records (the INPUTS of the backend) -------------------------------
+// Written right when the backend method is entered (not through Scope: the graph records it causes follow), with the
+// result record (tag | 0x100) when the method returns. Layouts in okvis_port/c/ok_vslam.h.
+enum BOp : uint32_t {
+  B_ADDCAM = 128, B_ADDIMU, B_ADDSTATES, B_SETKF, B_ADDLM_ID, B_ADDLM_NEW, B_SETLM, B_SETCLASS, B_ADDOBS, B_RMOBS,
+  B_SETOBSINFO, B_MERGELMS, B_MERGELM, B_APPLYSTRATEGY, B_OPTRT, B_OPTFULL, B_SYNC, B_CLEANLM, B_LCATTEMPT,
+  B_ADDLCFRAME, B_SETPOSE, B_SETSB, B_SETEXTR, B_CLEAR, B_DETRADIUS, B_FINALBA,
+  B_ML = 160, B_RESULT = 0x100
+};
+inline void bWrite(uint32_t tag, const Buf& b) {
+  okvis_port_solve::Buf w; w.raw(b.b.data(), b.b.size());
+  okvis_port_solve::plog.write(tag, w);
+}
+inline void mlWrite(uint64_t frame, uint32_t cam, uint32_t kp, uint64_t id) {
+  if (!on()) return;
+  Buf b; b.u64(frame); b.u32(cam); b.u32(kp); b.u64(id);
+  bWrite(B_ML, b);
+}
+struct MlInstall { MlInstall() { okvis_portk::mlHook() = &mlWrite; } };
+static MlInstall mlInstall;
+
+/// RAII: `args` is written when the object is created (call enter() after filling it), `res` when it goes out of scope.
+class BRec {
+ public:
+  explicit BRec(uint32_t tag) : tag_(tag), on_(on()) {}
+  bool live() const { return on_; }
+  void enter() { if (on_) bWrite(tag_, a); }
+  ~BRec() { if (on_ && hasRes) bWrite(tag_ | B_RESULT, r); }
+  Buf a, r;
+  bool hasRes = false;
+ private:
+  uint32_t tag_;
+  bool on_;
+};
+
 }  // namespace okvis_portv
 #endif
