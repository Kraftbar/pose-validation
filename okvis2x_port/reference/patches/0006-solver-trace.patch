diff --git a/okvis_ceres/include/okvis/ceres/OkvisPortTrace.hpp b/okvis_ceres/include/okvis/ceres/OkvisPortTrace.hpp
new file mode 100644
index 0000000..4ddb959
--- /dev/null
+++ b/okvis_ceres/include/okvis/ceres/OkvisPortTrace.hpp
@@ -0,0 +1,31 @@
+/* okvis_port reference instrumentation (NOT upstream code): graph-mutation event log, active only when
+ * OKVIS_PORT_TRACE_DIR is set (file events.txt). Used to localise run-to-run divergence. */
+#ifndef OKVIS_PORT_TRACE_HPP_
+#define OKVIS_PORT_TRACE_HPP_
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+namespace okvis_port {
+
+inline void traceEvent(const char* fmt, ...) {
+  static FILE* f = nullptr;
+  static bool init = false;
+  if (!init) {
+    init = true;
+    const char* d = std::getenv("OKVIS_PORT_TRACE_DIR");
+    if (d) f = std::fopen((std::string(d) + "/events.txt").c_str(), "w");
+  }
+  if (!f) return;
+  va_list ap;
+  va_start(ap, fmt);
+  std::vfprintf(f, fmt, ap);
+  va_end(ap);
+  std::fputc('\n', f);
+}
+
+}  // namespace okvis_port
+
+#endif  // OKVIS_PORT_TRACE_HPP_
