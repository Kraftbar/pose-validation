+// okvis_port (patch 0013): OPENGV RANSAC INPUT log (OKVIS_PORT_RANSAC_DIR/ransac.bin, same framing as problem.bin: u32 tag, u64 length,
+// payload; layouts in okvis_port/c/ok_opengv.h). 163 = absolute-pose adapter (kind, n, n x {bearing[3], point[3], camOffset[3],
+// camRotation[9] column-major, sigmaAngle}), 164 = relative adapter (kind, n, n x {bearing1[3], bearing2[3], sigma1, sigma2}),
+// 162 = the result record of patch 0012. No numerical effect.
+struct PortRansacBuf {
+  std::vector<unsigned char> b;
+  void raw(const void* p, size_t n) { const unsigned char* c = static_cast<const unsigned char*>(p); b.insert(b.end(), c, c + n); }
+  void u32(uint32_t v) { raw(&v, 4); }
+  void f64n(const double* p, size_t n) { raw(p, 8 * n); }
+};
+static FILE* portRansacFile() {
+  static FILE* f = []() -> FILE* {
+    const char* d = std::getenv("OKVIS_PORT_RANSAC_DIR");
+    if (!d) return nullptr;
+    return std::fopen((std::string(d) + "/ransac.bin").c_str(), "wb");
+  }();
+  return f;
+}
+static void portRansacWrite(uint32_t tag, const PortRansacBuf& b) {
+  FILE* f = portRansacFile();
+  if (!f) return;
+  const uint64_t len = b.b.size();
+  std::fwrite(&tag, 4, 1, f);
+  std::fwrite(&len, 8, 1, f);
+  std::fwrite(b.b.data(), 1, b.b.size(), f);
+  std::fflush(f);
+}
+template <class A>
+static void portRansacInAbs(uint32_t kind, A& a) {
+  if (!portRansacFile()) return;
+  PortRansacBuf b;
+  const size_t n = a.getNumberCorrespondences();
+  b.u32(kind); b.u32(uint32_t(n));
+  for (size_t i = 0; i < n; ++i) {
+    const Eigen::Vector3d f = a.getBearingVector(i), p = a.getPoint(i), t = a.getCamOffset(i);
+    const Eigen::Matrix3d R = a.getCamRotation(i);
+    const double s = a.getSigmaAngle(i);
+    b.f64n(f.data(), 3); b.f64n(p.data(), 3); b.f64n(t.data(), 3); b.f64n(R.data(), 9); b.f64n(&s, 1);
+  }
+  portRansacWrite(163, b);
+}
+template <class A>
+static void portRansacInRel(uint32_t kind, A& a) {
+  if (!portRansacFile()) return;
+  PortRansacBuf b;
+  const size_t n = a.getNumberCorrespondences();
+  b.u32(kind); b.u32(uint32_t(n));
+  for (size_t i = 0; i < n; ++i) {
+    const Eigen::Vector3d f1 = a.getBearingVector1(i), f2 = a.getBearingVector2(i);
+    const double s1 = a.getSigmaAngle1(i), s2 = a.getSigmaAngle2(i);
+    b.f64n(f1.data(), 3); b.f64n(f2.data(), 3); b.f64n(&s1, 1); b.f64n(&s2, 1);
+  }
+  portRansacWrite(164, b);
+}
+template <class R>
+static void portRansacOut(uint32_t kind, size_t numCorr, const R& r) {
+  if (!portRansacFile()) return;
+  PortRansacBuf b;
+  b.u32(kind); b.u32(uint32_t(numCorr)); b.u32(uint32_t(r.iterations_)); b.u32(uint32_t(r.inliers_.size()));
+  for (int i : r.inliers_) b.u32(uint32_t(i));
+  b.u32(uint32_t(r.model_coefficients_.rows())); b.u32(uint32_t(r.model_coefficients_.cols()));
+  b.f64n(r.model_coefficients_.data(), size_t(r.model_coefficients_.size()));
+  portRansacWrite(162, b);
+}
