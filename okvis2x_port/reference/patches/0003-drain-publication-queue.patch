0003: ThreadedSlam::stopThreading waits for the publication queue to drain before shutting it down (port of okvis_port
 patch 0006); otherwise the tail of the causal trajectory csv can be dropped under load.

--- a/okvis_multisensor_processing/src/ThreadedSlam.cpp
+++ b/okvis_multisensor_processing/src/ThreadedSlam.cpp
@@ -18,6 +18,8 @@
  */
 
 #include <map>
+#include <chrono>
+#include <thread>
 
 #include <pthread.h>
 #include <sched.h>
@@ -1308,6 +1310,15 @@
     optimisationThread_.join(); // this should not be necessary after having called processFrame.
   }
 
+  // DETERMINISTIC REFERENCE (okvis2x_port 0003): let the publishing thread drain the publication queue first.
+  // Upstream shuts the queue down immediately, so under load the last published states (the tail of the causal
+  // trajectory csv) are dropped depending on how far the publishing thread lags behind.
+  if (publishingThread_.joinable()) {
+    while (!publicationQueue_.Empty()) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+  }
+
   // shutdown queues
   imuMeasurementsReceived_.Shutdown();
   cameraMeasurementsReceived_.Shutdown();
