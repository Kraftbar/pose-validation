index 0000000..4ab780d
--- /dev/null
+++ b/okvis_ceres/include/okvis/ceres/OkvisPortGraphDump.hpp
@@ -0,0 +1,77 @@
+/*
+ * okvis_port reference instrumentation (NOT upstream code, patch 0009): binary dumps for module M5 (ViGraph /
+ * ViGraphEstimator numerics): TwoPoseGraphError compute() / convertToReprojectionErrors() / Evaluate() and
+ * ViGraph::updateLandmarks(). Active only when OKVIS_PORT_GRAPH_DUMP_DIR is set; one framed-record file graph.bin
+ * (u32 tag, u64 payload length, payload; native endian). Sampling: OKVIS_PORT_GRAPH_TPEVAL_EVERY (every Nth
+ * TwoPose*::EvaluateWithMinimalJacobians call, default 50), OKVIS_PORT_GRAPH_LM_EVERY (every Nth updateLandmarks()
+ * call, default 2), OKVIS_PORT_GRAPH_LM_SUB (every Kth landmark of a recorded call, default 8); compute() and
+ * convertToReprojectionErrors() are always recorded. Record layouts: okvis_port/c/ok_graph.h. The Ceres Problem
+ * bookkeeping log (problem.bin) lives in external/ceres-solver/include/ceres/okvis_port_solve_hooks.h.
+ * Observational only: no computed value changes, no uninitialised memory is read.
+ */
+#ifndef OKVIS_PORT_GRAPH_DUMP_HPP_
+#define OKVIS_PORT_GRAPH_DUMP_HPP_
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <okvis/kinematics/OkvisPortKinDump.hpp>
+
+namespace okvis_portg {
+
+enum Record : uint32_t { G_TP_COMPUTE = 1, G_TP_CONVERT = 2, G_TP_EVAL = 3, G_LM_UPDATE = 4 };
+
+using Buf = okvis_portk::Buf;
+
+class Dump {
+ public:
+  static Dump& get() { static Dump d; return d; }
+  bool enabled() const { return enabled_; }
+  bool onEval() { if (!enabled_) return false; std::lock_guard<std::mutex> l(m_); const uint64_t c = evalCalls_++; return evalEvery_ > 0 && (c % evalEvery_) == 0; }
+  bool onLm() { if (!enabled_) return false; std::lock_guard<std::mutex> l(m_); const uint64_t c = lmCalls_++; return lmEvery_ > 0 && (c % lmEvery_) == 0; }
+  uint64_t lmSub() const { return lmSub_; }
+  void write(uint32_t rec, const Buf& b) {
+    if (!enabled_) return;
+    std::lock_guard<std::mutex> l(m_);
+    if (!f_) f_ = std::fopen((dir_ + "/graph.bin").c_str(), "wb");
+    const uint64_t n = b.b.size();
+    std::fwrite(&rec, 4, 1, f_);
+    std::fwrite(&n, 8, 1, f_);
+    if (n) std::fwrite(b.b.data(), 1, n, f_);
+    written_[rec]++;
+  }
+  ~Dump() {
+    if (!enabled_) return;
+    if (f_) std::fclose(f_);
+    std::fprintf(stderr, "okvis_port graph dump: tp_compute=%llu tp_convert=%llu tp_eval=%llu (calls %llu) lm_update=%llu (calls %llu)\n",
+                 (unsigned long long)written_[G_TP_COMPUTE], (unsigned long long)written_[G_TP_CONVERT],
+                 (unsigned long long)written_[G_TP_EVAL], (unsigned long long)evalCalls_,
+                 (unsigned long long)written_[G_LM_UPDATE], (unsigned long long)lmCalls_);
+  }
+
+ private:
+  Dump() {
+    const char* d = std::getenv("OKVIS_PORT_GRAPH_DUMP_DIR");
+    enabled_ = d != nullptr;
+    if (d) dir_ = d;
+    for (int k = 0; k < 8; ++k) written_[k] = 0;
+    if (const char* e = std::getenv("OKVIS_PORT_GRAPH_TPEVAL_EVERY")) evalEvery_ = std::strtoull(e, nullptr, 10);
+    if (const char* e = std::getenv("OKVIS_PORT_GRAPH_LM_EVERY")) lmEvery_ = std::strtoull(e, nullptr, 10);
+    if (const char* e = std::getenv("OKVIS_PORT_GRAPH_LM_SUB")) lmSub_ = std::strtoull(e, nullptr, 10);
+  }
+  bool enabled_ = false;
+  std::string dir_;
+  std::mutex m_;
+  FILE* f_ = nullptr;
+  uint64_t evalEvery_ = 50, lmEvery_ = 2, lmSub_ = 8, evalCalls_ = 0, lmCalls_ = 0;
+  uint64_t written_[8];
+};
+
+}  // namespace okvis_portg
+
+#endif  // OKVIS_PORT_GRAPH_DUMP_HPP_
